# Copy to .env and fill in real values. Never commit .env.

# --- Local development (optional; unset to use Neon) ---
# Embedded Postgres (PGlite) for local dev, plus local file publishing.
# This lets you test the whole flow without external services.
DATABASE_DRIVER="pglite"
PGLITE_DATA_DIR="pglite-data"
DEV_AUTO_VERIFY="true"
PUBLISH_MODE="local"
ADMIN_EMAILS="admin@example.com"

# --- Production ---
# Database (Neon serverless Postgres)
NEON_DATABASE_URL="postgresql://user:password@ep-xxx.region.aws.neon.tech/qrnlab?sslmode=require"

# Auth
BETTER_AUTH_SECRET="generate-with: openssl rand -base64 32"
BETTER_AUTH_URL="http://localhost:4321"

# Email verification (Resend) — set MAIL_FROM to a verified domain address
RESEND_API_KEY=""
MAIL_FROM="QRNLab <onboarding@qrnlab.dev>"

# Comma-separated emails that are auto-promoted to admin on sign-up (first admin bootstrap)
ADMIN_EMAILS=""

# GitHub publish pipeline (fine-grained PAT scoped to the site repo:
# Contents read/write + Pull requests read/write)
GITHUB_TOKEN=""
GITHUB_REPO_OWNER=""
GITHUB_REPO_NAME=""
