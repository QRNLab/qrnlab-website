# Copy to .dev.vars for local development (gitignored). Never commit real values.
# Production secrets are set with `wrangler secret put <NAME>` (or in the dashboard).

# --- Local development ---
DEV_AUTO_VERIFY="true"
ADMIN_EMAILS="admin@example.com"

# --- Auth ---
# Production default set in wrangler.jsonc vars
BETTER_AUTH_SECRET="generate-with: openssl rand -base64 32"
BETTER_AUTH_URL="http://localhost:4321"

# Email verification (Resend) — set MAIL_FROM to a verified domain address
RESEND_API_KEY=""
MAIL_FROM="QRNLab <onboarding@qrnlab.dev>"

# Comma-separated emails auto-promoted to admin on sign-up (first admin bootstrap)
ADMIN_EMAILS=""

# --- Build-time data endpoint (content loaders fetch published content here) ---
# Locally the dev server; in production/Workers Builds, the deployed site URL.
BUILD_API_URL="http://localhost:4321"
BUILD_TOKEN=""

# --- Rebuild on publish ---
# Cloudflare Workers Builds Deploy Hook URL; POSTed when content is published/approved.
DEPLOY_HOOK_URL=""

# Note: the D1 database and R2 bucket are bound via wrangler.jsonc (DB / MEDIA_BUCKET),
# not through .env. Local D1/R2 emulation is provided automatically by wrangler.
