---
import Avatar from "./Avatar.astro";

export interface Props {
  entry: any;
}

const { entry } = Astro.props;
const { data, id } = entry;
---

<a
  href={`/team/alumni/${id}`}
  class="flex flex-col items-center rounded-lg border border-neutral-200 dark:border-neutral-700 p-5 text-center hover:border-blue-300 dark:hover:border-blue-600 hover:bg-blue-50/30 dark:hover:bg-blue-950/30 transition-colors"
>
  <Avatar name={data.name} size={72} />
  <h3 class="mt-3 font-medium text-neutral-900 dark:text-neutral-100">{data.name}</h3>
  {(data.currentPosition || data.currentInstitution) && (
    <p class="mt-1.5 text-sm font-medium text-amber-600 dark:text-amber-400">
      {[data.currentPosition, data.currentInstitution].filter(Boolean).join(" @ ")}
    </p>
  )}
  {data.yearGraduated && (
    <p class="mt-1 text-xs text-neutral-500 dark:text-neutral-400">Graduated {data.yearGraduated}</p>
  )}
</a>
