---
import BaseLayout from "../layouts/BaseLayout.astro";
---

<BaseLayout title="Publications" description="QRNLab publications and conference attendings">
  <h1 class="text-3xl font-semibold tracking-tight">Publications</h1>

  <section class="mt-8">
    <h2 class="text-2xl font-medium tracking-tight border-b border-neutral-200 dark:border-neutral-700 pb-2">Journal Papers</h2>
    <p class="mt-4 text-sm text-neutral-500 dark:text-neutral-400 italic">No papers listed yet.</p>
  </section>

  <section class="mt-12">
    <h2 class="text-2xl font-medium tracking-tight border-b border-neutral-200 dark:border-neutral-700 pb-2">Conference Attendings</h2>
    <p class="mt-4 text-sm text-neutral-500 dark:text-neutral-400 italic">No conference attendings listed yet.</p>
  </section>
</BaseLayout>
