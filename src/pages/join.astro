---
import BaseLayout from "../layouts/BaseLayout.astro";
---

<BaseLayout title="Register" description="Register an account to submit your profile to QRNLab">
  <div class="mx-auto max-w-md">
    <h1 class="text-3xl font-semibold tracking-tight">Register</h1>
    <p class="mt-2 text-sm text-neutral-500 dark:text-neutral-400">
      Create an account to register with the lab. After verifying your email you can submit your profile, which an admin approves before it goes live.
    </p>

    <form id="join-form" class="mt-8 space-y-4" novalidate>
      <div>
        <label for="name" class="block text-sm font-medium text-neutral-700 dark:text-neutral-300">Full name</label>
        <input
          id="name"
          name="name"
          type="text"
          required
          autocomplete="name"
          class="mt-1 w-full rounded border border-neutral-300 dark:border-neutral-600 bg-white dark:bg-neutral-800 px-3 py-2 text-sm text-neutral-900 dark:text-neutral-100 focus:border-blue-500 focus:outline-none"
        />
      </div>
      <div>
        <label for="email" class="block text-sm font-medium text-neutral-700 dark:text-neutral-300">Email</label>
        <input
          id="email"
          name="email"
          type="email"
          required
          autocomplete="email"
          class="mt-1 w-full rounded border border-neutral-300 dark:border-neutral-600 bg-white dark:bg-neutral-800 px-3 py-2 text-sm text-neutral-900 dark:text-neutral-100 focus:border-blue-500 focus:outline-none"
        />
      </div>
      <div>
        <label for="password" class="block text-sm font-medium text-neutral-700 dark:text-neutral-300">Password</label>
        <input
          id="password"
          name="password"
          type="password"
          required
          minlength={8}
          autocomplete="new-password"
          class="mt-1 w-full rounded border border-neutral-300 dark:border-neutral-600 bg-white dark:bg-neutral-800 px-3 py-2 text-sm text-neutral-900 dark:text-neutral-100 focus:border-blue-500 focus:outline-none"
        />
        <p class="mt-1 text-xs text-neutral-400 dark:text-neutral-500">At least 8 characters.</p>
      </div>

      <p id="error" class="hidden text-sm text-red-600 dark:text-red-400"></p>
      <p id="done" class="hidden rounded border border-green-300 dark:border-green-700 bg-green-50 dark:bg-green-950/30 p-3 text-sm text-green-800 dark:text-green-300">
        Account created. We sent a verification email to your inbox — click the link to verify, then sign in.
      </p>

      <button
        type="submit"
        class="w-full rounded bg-[#0b0d39] dark:bg-[#f4f2c7] px-4 py-2 text-sm font-medium text-white dark:text-[#0b0d39] hover:opacity-90 transition-opacity"
      >
        Create account
      </button>
    </form>

    <p class="mt-6 text-sm text-neutral-500 dark:text-neutral-400">
      Already have an account? <a href="/login" class="text-blue-700 dark:text-blue-400 hover:underline">Sign in</a>
    </p>
  </div>
</BaseLayout>

<script>
  const form = document.getElementById("join-form") as HTMLFormElement;
  const errorEl = document.getElementById("error")!;
  const doneEl = document.getElementById("done")!;

  form.addEventListener("submit", async (e) => {
    e.preventDefault();
    errorEl.classList.add("hidden");
    doneEl.classList.add("hidden");
    const name = (form.elements.namedItem("name") as HTMLInputElement).value;
    const email = (form.elements.namedItem("email") as HTMLInputElement).value;
    const password = (form.elements.namedItem("password") as HTMLInputElement).value;

    const res = await fetch("/api/auth/sign-up/email", {
      method: "POST",
      headers: { "Content-Type": "application/json" },
      body: JSON.stringify({ name, email, password }),
    });

    if (res.ok) {
      // Auto sign-in right after registering (works in dev via DEV_AUTO_VERIFY;
      // in production the email must be verified first, so we fall back to the
      // verification message).
      const loginRes = await fetch("/api/auth/sign-in/email", {
        method: "POST",
        headers: { "Content-Type": "application/json" },
        body: JSON.stringify({ email, password }),
      });
      if (loginRes.ok) {
        location.href = "/account";
        return;
      }
      form.classList.add("hidden");
      doneEl.classList.remove("hidden");
      return;
    }

    let message = "Could not create the account.";
    const data = await res.json().catch(() => null);
    if (data?.message) message = data.message;
    errorEl.textContent = message;
    errorEl.classList.remove("hidden");
  });
</script>
