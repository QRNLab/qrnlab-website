---
import BaseLayout from "../../layouts/BaseLayout.astro";

export const prerender = false;
---

<BaseLayout title="My posts" description="Write and manage your blog posts">
  <div class="flex items-center justify-between gap-4">
    <div>
      <h1 class="text-3xl font-semibold tracking-tight">My posts</h1>
      <p class="mt-1 text-sm text-neutral-500 dark:text-neutral-400">Write a post, then submit it for review. An editor or the PI publishes it after review.</p>
    </div>
    <button id="new-post" class="shrink-0 rounded bg-[#0b0d39] dark:bg-[#f4f2c7] px-4 py-2 text-sm font-medium text-white dark:text-[#0b0d39] hover:opacity-90 transition-opacity">New post</button>
  </div>

  <p id="unpublish-note" class="hidden mt-4 rounded-lg border border-amber-200 dark:border-amber-800 bg-amber-50 dark:bg-amber-950/30 px-4 py-3 text-sm text-amber-800 dark:text-amber-300">
    Editing a published post takes it offline until it is reviewed and republished.
  </p>

  <div id="list" class="mt-8"></div>

  <section id="editor" class="mt-10 hidden">
    <h2 id="editor-title" class="text-2xl font-medium tracking-tight border-b border-neutral-200 dark:border-neutral-700 pb-2">New post</h2>

    <form id="post-form" class="mt-6 space-y-4">
      <input type="hidden" id="post-id" />
      <div>
        <label for="title" class="block text-sm font-medium text-neutral-700 dark:text-neutral-300">Title</label>
        <input id="title" type="text" required
          class="mt-1 w-full rounded border border-neutral-300 dark:border-neutral-600 bg-white dark:bg-neutral-800 px-3 py-2 text-sm text-neutral-900 dark:text-neutral-100 focus:border-blue-500 focus:outline-none" />
      </div>
      <div>
        <label for="excerpt" class="block text-sm font-medium text-neutral-700 dark:text-neutral-300">Excerpt <span class="font-normal text-neutral-400 dark:text-neutral-500">(optional — otherwise the first lines of the post are shown)</span></label>
        <input id="excerpt" type="text"
          class="mt-1 w-full rounded border border-neutral-300 dark:border-neutral-600 bg-white dark:bg-neutral-800 px-3 py-2 text-sm text-neutral-900 dark:text-neutral-100 focus:border-blue-500 focus:outline-none" />
      </div>
      <div>
        <label for="tags" class="block text-sm font-medium text-neutral-700 dark:text-neutral-300">Tags <span class="font-normal text-neutral-400 dark:text-neutral-500">(comma separated)</span></label>
        <input id="tags" type="text"
          class="mt-1 w-full rounded border border-neutral-300 dark:border-neutral-600 bg-white dark:bg-neutral-800 px-3 py-2 text-sm text-neutral-900 dark:text-neutral-100 focus:border-blue-500 focus:outline-none" />
      </div>
      <div>
        <label for="body" class="block text-sm font-medium text-neutral-700 dark:text-neutral-300">Body (Markdown + KaTeX)</label>
        <textarea id="body" rows={14} required
          class="mt-1 w-full rounded border border-neutral-300 dark:border-neutral-600 bg-white dark:bg-neutral-800 px-3 py-2 font-mono text-sm text-neutral-900 dark:text-neutral-100 focus:border-blue-500 focus:outline-none"></textarea>
        <div class="mt-2 flex items-center gap-2">
          <label class="cursor-pointer rounded border border-neutral-300 dark:border-neutral-600 px-3 py-1.5 text-sm text-neutral-700 dark:text-neutral-300 hover:bg-neutral-100 dark:hover:bg-neutral-800 transition-colors">
            Insert image
            <input id="image-input" type="file" accept="image/jpeg,image/png,image/webp,image/gif,image/avif" class="sr-only" />
          </label>
          <span id="image-status" class="text-xs text-neutral-400 dark:text-neutral-500">Uploads to the media library; inserts a Markdown image link.</span>
        </div>
      </div>

      <div class="flex flex-wrap gap-2">
        <button type="button" id="preview-toggle" class="rounded border border-neutral-300 dark:border-neutral-600 px-4 py-2 text-sm text-neutral-700 dark:text-neutral-300 hover:bg-neutral-100 dark:hover:bg-neutral-800 transition-colors">Preview</button>
        <button type="submit" class="rounded bg-[#0b0d39] dark:bg-[#f4f2c7] px-4 py-2 text-sm font-medium text-white dark:text-[#0b0d39] hover:opacity-90 transition-opacity">Save draft</button>
        <button type="button" id="submit-btn" class="rounded bg-green-700 dark:bg-green-600 px-4 py-2 text-sm font-medium text-white hover:opacity-90 transition-opacity">Submit for review</button>
        <button type="button" id="cancel-btn" class="rounded border border-neutral-300 dark:border-neutral-600 px-4 py-2 text-sm text-neutral-700 dark:text-neutral-300 hover:bg-neutral-100 dark:hover:bg-neutral-800 transition-colors">Cancel</button>
      </div>

      <p id="error" class="hidden text-sm text-red-600 dark:text-red-400"></p>
      <p id="done" class="hidden text-sm text-green-700 dark:text-green-400"></p>
    </form>

    <div id="preview" class="mt-6 hidden rounded-lg border border-neutral-200 dark:border-neutral-700 p-6"></div>
  </section>
</BaseLayout>

<script>
  import { api } from "../../lib/client/api";
  import { bindPostForm, renderPostList, type BlogPost, type Me } from "../../lib/client/blogEditor";

  const listEl = document.getElementById("list")!;
  const editorEl = document.getElementById("editor")!;
  const editorTitle = document.getElementById("editor-title")!;
  const form = document.getElementById("post-form") as HTMLFormElement;
  const unpublishNote = document.getElementById("unpublish-note")!;

  const formController = bindPostForm({
    form,
    idInput: document.getElementById("post-id") as HTMLInputElement,
    titleInput: document.getElementById("title") as HTMLInputElement,
    excerptInput: document.getElementById("excerpt") as HTMLInputElement,
    tagsInput: document.getElementById("tags") as HTMLInputElement,
    bodyInput: document.getElementById("body") as HTMLTextAreaElement,
    imageInput: document.getElementById("image-input") as HTMLInputElement,
    imageStatus: document.getElementById("image-status")!,
    errorEl: document.getElementById("error")!,
    doneEl: document.getElementById("done")!,
    previewEl: document.getElementById("preview")!,
    previewToggle: document.getElementById("preview-toggle")!,
    editorEl,
    editorTitle,
    onSaved: load,
  });

  let posts: BlogPost[] = [];
  let me: Me = { id: "", role: "member", canModerate: false };

  async function load() {
    const data = await api<{ posts: BlogPost[]; me: Me }>("/content/blog");
    posts = data.posts ?? [];
    me = data.me;
    renderPostList({
      container: listEl,
      posts,
      me,
      emptyText: "No posts yet. Write your first post!",
      actions: {
        edit: (post) => {
          formController.openEdit(post);
          unpublishNote.classList.toggle("hidden", post.status !== "published");
          window.scrollTo({ top: editorEl.offsetTop - 80, behavior: "smooth" });
        },
        submit: (post) => submitPost(post.id),
        publish: () => {},
        reject: () => {},
        remove: (post) => deletePost(post),
        viewUrl: (post) => (post.status === "published" ? `/blog/${post.slug}` : null),
      },
    });
  }

  async function submitPost(id: string) {
    try {
      await api(`/content/blog/${id}/submit`, { method: "POST" });
      await load();
    } catch (err: any) {
      formController.setMessage(err.message ?? "Submit failed.", true);
    }
  }

  async function deletePost(post: BlogPost) {
    if (!confirm(`Delete "${post.title}"? This cannot be undone.`)) return;
    try {
      await api(`/content/blog/${post.id}`, { method: "DELETE" });
      await load();
    } catch (err: any) {
      formController.setMessage(err.message ?? "Delete failed.", true);
    }
  }

  document.getElementById("new-post")!.addEventListener("click", () => {
    unpublishNote.classList.add("hidden");
    formController.openNew();
    window.scrollTo({ top: editorEl.offsetTop - 80, behavior: "smooth" });
  });

  document.getElementById("cancel-btn")!.addEventListener("click", () => {
    editorEl.classList.add("hidden");
    unpublishNote.classList.add("hidden");
  });

  document.getElementById("submit-btn")!.addEventListener("click", async () => {
    if (!formController.getEditingId()) {
      await formController.saveDraft();
    }
    const id = formController.getEditingId();
    if (id) await submitPost(id);
  });

  load();
</script>
