---
import BaseLayout from "../../layouts/BaseLayout.astro";
import RoleSelect from "../../components/RoleSelect.astro";
import { eq } from "drizzle-orm";
import { getDb } from "../../lib/server/db";
import { memberProfiles } from "../../lib/server/schema";

export const prerender = false;

const session = Astro.locals.session;
const db = await getDb();
const [profile] = session
  ? await db.select().from(memberProfiles).where(eq(memberProfiles.userId, session.user.id))
  : [];
const p = profile ?? null;

const linksText = (p?.links ?? []).map((l) => `${l.label} :: ${l.url}`).join("\n");
---

<BaseLayout title="Edit profile" description="Edit your QRNLab profile">
  <div class="flex flex-wrap items-center justify-between gap-4">
    <h1 class="text-3xl font-semibold tracking-tight">Edit profile</h1>
    <a href="/account" class="text-sm text-blue-700 dark:text-blue-400 hover:underline">&larr; Back to profile</a>
  </div>

  <p class="mt-2 max-w-2xl text-sm text-neutral-500 dark:text-neutral-400">
    This content is published on the Team page after an admin approves it. Saving returns the profile to "pending".
  </p>

  <section class="mt-6 max-w-2xl">
    <form id="profile-form" class="space-y-4" novalidate>
      <div>
        <span class="block text-sm font-medium text-neutral-700 dark:text-neutral-300">Are you a member or alumni?</span>
        <div class="mt-2 grid gap-2 sm:grid-cols-2">
          <label for="cat-member" class="cursor-pointer rounded-lg border border-neutral-300 dark:border-neutral-600 px-4 py-3 transition-colors hover:border-neutral-400 dark:hover:border-neutral-500 has-[:checked]:border-blue-600 has-[:checked]:bg-blue-50 dark:has-[:checked]:border-blue-400 dark:has-[:checked]:bg-blue-950/30 has-[:checked]:ring-1 has-[:checked]:ring-blue-600 dark:has-[:checked]:ring-blue-400">
            <input type="radio" name="category" id="cat-member" value="member" class="sr-only" checked={p?.category !== "alumni"} />
            <span class="block text-sm font-medium text-neutral-900 dark:text-neutral-100">Current member</span>
            <span class="block text-xs text-neutral-500 dark:text-neutral-400">Listed under Current Members on the Team page</span>
          </label>
          <label for="cat-alumni" class="cursor-pointer rounded-lg border border-neutral-300 dark:border-neutral-600 px-4 py-3 transition-colors hover:border-neutral-400 dark:hover:border-neutral-500 has-[:checked]:border-blue-600 has-[:checked]:bg-blue-50 dark:has-[:checked]:border-blue-400 dark:has-[:checked]:bg-blue-950/30 has-[:checked]:ring-1 has-[:checked]:ring-blue-600 dark:has-[:checked]:ring-blue-400">
            <input type="radio" name="category" id="cat-alumni" value="alumni" class="sr-only" checked={p?.category === "alumni"} />
            <span class="block text-sm font-medium text-neutral-900 dark:text-neutral-100">Alumni</span>
            <span class="block text-xs text-neutral-500 dark:text-neutral-400">Listed under Alumni on the Team page</span>
          </label>
        </div>
      </div>

      <div id="alumni-fields" class={`grid gap-4 sm:grid-cols-3 ${p?.category === "alumni" ? "" : "hidden"}`}>
        <div>
          <label for="currentPosition" class="block text-sm font-medium text-neutral-700 dark:text-neutral-300">Current position</label>
          <input id="currentPosition" name="currentPosition" type="text" value={p?.currentPosition ?? ""} placeholder="e.g. Postdoctoral Fellow"
            class="mt-1 w-full rounded border border-neutral-300 dark:border-neutral-600 bg-white dark:bg-neutral-800 px-3 py-2 text-sm text-neutral-900 dark:text-neutral-100 focus:border-blue-500 focus:outline-none" />
        </div>
        <div>
          <label for="currentInstitution" class="block text-sm font-medium text-neutral-700 dark:text-neutral-300">Current institution</label>
          <input id="currentInstitution" name="currentInstitution" type="text" value={p?.currentInstitution ?? ""} placeholder="e.g. University of Tokyo"
            class="mt-1 w-full rounded border border-neutral-300 dark:border-neutral-600 bg-white dark:bg-neutral-800 px-3 py-2 text-sm text-neutral-900 dark:text-neutral-100 focus:border-blue-500 focus:outline-none" />
        </div>
        <div>
          <label for="yearGraduated" class="block text-sm font-medium text-neutral-700 dark:text-neutral-300">Graduation year</label>
          <input id="yearGraduated" name="yearGraduated" type="number" min={1900} max={2100} value={p?.yearGraduated ?? ""}
            class="mt-1 w-full rounded border border-neutral-300 dark:border-neutral-600 bg-white dark:bg-neutral-800 px-3 py-2 text-sm text-neutral-900 dark:text-neutral-100 focus:border-blue-500 focus:outline-none" />
        </div>
      </div>

      <div>
        <label for="name" class="block text-sm font-medium text-neutral-700 dark:text-neutral-300">Full name</label>
        <input id="name" name="name" type="text" required value={p?.name ?? ""}
          class="mt-1 w-full rounded border border-neutral-300 dark:border-neutral-600 bg-white dark:bg-neutral-800 px-3 py-2 text-sm text-neutral-900 dark:text-neutral-100 focus:border-blue-500 focus:outline-none" />
      </div>

      <div>
        <span class="block text-sm font-medium text-neutral-700 dark:text-neutral-300">Profile picture</span>
        <div class="mt-2 flex items-center gap-4">
          <img id="avatar-preview" src={p?.image ?? ""} alt="" class={`h-20 w-20 rounded-full object-cover ${p?.image ? "" : "hidden"}`} />
          <div class="flex items-center gap-2">
            <label class="cursor-pointer rounded border border-neutral-300 dark:border-neutral-600 px-3 py-1.5 text-sm text-neutral-700 dark:text-neutral-300 hover:bg-neutral-100 dark:hover:bg-neutral-800 transition-colors">
              Choose image
              <input id="avatar-file" type="file" accept="image/jpeg,image/png,image/webp,image/gif,image/avif" class="sr-only" />
            </label>
            <button type="button" id="avatar-remove" class={`text-sm text-neutral-500 dark:text-neutral-400 hover:text-red-600 transition-colors ${p?.image ? "" : "hidden"}`}>Remove</button>
          </div>
        </div>
        <input type="hidden" id="avatar-url" value={p?.image ?? ""} />
        <p class="mt-1 text-xs text-neutral-400 dark:text-neutral-500">JPEG, PNG, WebP, GIF or AVIF, up to 10 MB. Saved with your profile; shown after approval.</p>
      </div>

      <div class="grid gap-4 sm:grid-cols-2">
        <div>
          <label class="block text-sm font-medium text-neutral-700 dark:text-neutral-300">Role</label>
          <RoleSelect name="role" value={p?.role ?? ""} />
        </div>
        <div>
          <label for="focus" class="block text-sm font-medium text-neutral-700 dark:text-neutral-300">Research focus</label>
          <input id="focus" name="focus" type="text" value={p?.focus ?? ""} placeholder="e.g. Computational Quantum Theorist"
            class="mt-1 w-full rounded border border-neutral-300 dark:border-neutral-600 bg-white dark:bg-neutral-800 px-3 py-2 text-sm text-neutral-900 dark:text-neutral-100 focus:border-blue-500 focus:outline-none" />
        </div>
      </div>

      <div>
        <label for="email" class="block text-sm font-medium text-neutral-700 dark:text-neutral-300">Contact email (public)</label>
        <input id="email" name="email" type="email" value={p?.email ?? ""}
          class="mt-1 w-full rounded border border-neutral-300 dark:border-neutral-600 bg-white dark:bg-neutral-800 px-3 py-2 text-sm text-neutral-900 dark:text-neutral-100 focus:border-blue-500 focus:outline-none" />
      </div>

      <div>
        <label for="bio" class="block text-sm font-medium text-neutral-700 dark:text-neutral-300">Biography</label>
        <textarea id="bio" name="bio" rows={6}
          class="mt-1 w-full rounded border border-neutral-300 dark:border-neutral-600 bg-white dark:bg-neutral-800 px-3 py-2 text-sm text-neutral-900 dark:text-neutral-100 focus:border-blue-500 focus:outline-none">{p?.bio ?? ""}</textarea>
        <p class="mt-1 text-xs text-neutral-400 dark:text-neutral-500">Plain text — blank lines create paragraphs.</p>
      </div>

      <div class="grid gap-4 sm:grid-cols-2">
        <div>
          <label for="website" class="block text-sm font-medium text-neutral-700 dark:text-neutral-300">Website</label>
          <input id="website" name="website" type="url" value={p?.website ?? ""}
            class="mt-1 w-full rounded border border-neutral-300 dark:border-neutral-600 bg-white dark:bg-neutral-800 px-3 py-2 text-sm text-neutral-900 dark:text-neutral-100 focus:border-blue-500 focus:outline-none" />
        </div>
        <div>
          <label for="scholar" class="block text-sm font-medium text-neutral-700 dark:text-neutral-300">Google Scholar</label>
          <input id="scholar" name="scholar" type="url" value={p?.scholar ?? ""}
            class="mt-1 w-full rounded border border-neutral-300 dark:border-neutral-600 bg-white dark:bg-neutral-800 px-3 py-2 text-sm text-neutral-900 dark:text-neutral-100 focus:border-blue-500 focus:outline-none" />
        </div>
        <div>
          <label for="linkedin" class="block text-sm font-medium text-neutral-700 dark:text-neutral-300">LinkedIn</label>
          <input id="linkedin" name="linkedin" type="url" value={p?.linkedin ?? ""}
            class="mt-1 w-full rounded border border-neutral-300 dark:border-neutral-600 bg-white dark:bg-neutral-800 px-3 py-2 text-sm text-neutral-900 dark:text-neutral-100 focus:border-blue-500 focus:outline-none" />
        </div>
        <div>
          <label for="github" class="block text-sm font-medium text-neutral-700 dark:text-neutral-300">GitHub</label>
          <input id="github" name="github" type="url" value={p?.github ?? ""}
            class="mt-1 w-full rounded border border-neutral-300 dark:border-neutral-600 bg-white dark:bg-neutral-800 px-3 py-2 text-sm text-neutral-900 dark:text-neutral-100 focus:border-blue-500 focus:outline-none" />
        </div>
      </div>

      <div>
        <label for="links" class="block text-sm font-medium text-neutral-700 dark:text-neutral-300">
          Other links <span class="font-normal text-neutral-400 dark:text-neutral-500">(one per line: <code>Label :: URL</code>)</span>
        </label>
        <textarea id="links" name="links" rows={3}
          class="mt-1 w-full rounded border border-neutral-300 dark:border-neutral-600 bg-white dark:bg-neutral-800 px-3 py-2 text-sm text-neutral-900 dark:text-neutral-100 focus:border-blue-500 focus:outline-none">{linksText}</textarea>
      </div>

      <div>
        <label class="block text-sm font-medium text-neutral-700 dark:text-neutral-300">Publications</label>
        <div id="pubs-editor" data-initial={JSON.stringify(p?.publications ?? [])} class="mt-2 space-y-3"></div>
        <button
          type="button"
          id="pubs-add"
          class="mt-3 inline-flex items-center gap-1.5 rounded border border-neutral-300 dark:border-neutral-600 px-3 py-1.5 text-sm text-neutral-700 dark:text-neutral-300 hover:bg-neutral-100 dark:hover:bg-neutral-800 transition-colors"
        >
          <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><line x1="12" y1="5" x2="12" y2="19"/><line x1="5" y1="12" x2="19" y2="12"/></svg>
          Add publication
        </button>
        <p class="mt-1 text-xs text-neutral-400 dark:text-neutral-500">Fill the fields to build a citation, or paste a full citation directly. These are separate from the lab's publication list.</p>
      </div>

      <p id="error" class="hidden text-sm text-red-600 dark:text-red-400"></p>

      <div class="flex items-center gap-3">
        <button
          type="submit"
          class="rounded bg-[#0b0d39] dark:bg-[#f4f2c7] px-5 py-2 text-sm font-medium text-white dark:text-[#0b0d39] hover:opacity-90 transition-opacity"
        >
          Save &amp; submit for review
        </button>
        <a href="/account" class="text-sm text-neutral-500 dark:text-neutral-400 hover:text-blue-700 dark:hover:text-blue-400 transition-colors">Cancel</a>
      </div>
    </form>
  </section>
</BaseLayout>

<script>
  const form = document.getElementById("profile-form") as HTMLFormElement;
  const errorEl = document.getElementById("error")!;
  const alumniFields = document.getElementById("alumni-fields")!;
  const memberRadio = form.querySelector<HTMLInputElement>('input[name="category"][value="member"]')!;
  const alumniRadio = form.querySelector<HTMLInputElement>('input[name="category"][value="alumni"]')!;
  function syncCategory() {
    alumniFields.classList.toggle("hidden", !alumniRadio.checked);
  }
  memberRadio.addEventListener("change", syncCategory);
  alumniRadio.addEventListener("change", syncCategory);

  const avatarPreview = document.getElementById("avatar-preview") as HTMLImageElement;
  const avatarFile = document.getElementById("avatar-file") as HTMLInputElement;
  const avatarUrlInput = document.getElementById("avatar-url") as HTMLInputElement;
  const avatarRemove = document.getElementById("avatar-remove") as HTMLButtonElement;

  function setAvatar(url: string) {
    avatarUrlInput.value = url;
    if (url) {
      avatarPreview.src = url;
      avatarPreview.classList.remove("hidden");
      avatarRemove.classList.remove("hidden");
    } else {
      avatarPreview.src = "";
      avatarPreview.classList.add("hidden");
      avatarRemove.classList.add("hidden");
    }
  }

  avatarFile.addEventListener("change", async () => {
    const file = avatarFile.files?.[0];
    if (!file) return;
    errorEl.classList.add("hidden");
    const formData = new FormData();
    formData.append("file", file);
    formData.append("purpose", "avatar");
    try {
      const res = await fetch("/api/media", { method: "POST", body: formData });
      const data = await res.json().catch(() => null);
      if (!res.ok) throw new Error(data?.error ?? "Upload failed.");
      setAvatar(data.url);
    } catch (err: any) {
      errorEl.textContent = err.message ?? "Upload failed.";
      errorEl.classList.remove("hidden");
    }
    avatarFile.value = "";
  });

  avatarRemove.addEventListener("click", () => setAvatar(""));

  const pubsEditor = document.getElementById("pubs-editor")!;
  const pubsAdd = document.getElementById("pubs-add")!;
  interface PubRow {
    id: number;
    mode: "structured" | "raw";
    authors: string;
    title: string;
    venue: string;
    year: string;
    text: string;
  }
  let pubId = 0;
  let pubRows: PubRow[] = (JSON.parse(pubsEditor.dataset.initial || "[]") as string[]).map(
    (s) => ({ id: pubId++, mode: "raw", authors: "", title: "", venue: "", year: "", text: s }),
  );

  function pubCitation(r: PubRow): string {
    if (r.mode === "raw") return r.text.trim();
    const venueYear = [r.venue.trim(), r.year.trim()].filter(Boolean).join(", ");
    let c = [r.authors.trim(), r.title.trim() ? `"${r.title.trim()}."` : "", venueYear]
      .filter(Boolean)
      .join(" ");
    if (c && !/[.!?]$/.test(c)) c += ".";
    return c;
  }

  function renderPubs() {
    pubsEditor.innerHTML = "";
    for (const r of pubRows) {
      const row = document.createElement("div");
      row.className = "relative rounded-lg border border-neutral-200 dark:border-neutral-700 p-3";
      const remove = document.createElement("button");
      remove.type = "button";
      remove.className = "absolute right-2 top-2 rounded p-1 text-neutral-400 hover:text-red-500 transition-colors";
      remove.setAttribute("aria-label", "Remove publication");
      remove.innerHTML =
        '<svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><line x1="18" y1="6" x2="6" y2="18"/><line x1="6" y1="6" x2="18" y2="18"/></svg>';
      remove.addEventListener("click", () => {
        pubRows = pubRows.filter((x) => x.id !== r.id);
        renderPubs();
      });
      row.appendChild(remove);

      const preview = document.createElement("p");
      preview.className =
        "mt-2 rounded bg-neutral-50 dark:bg-neutral-800/50 px-2.5 py-1.5 text-xs text-neutral-500 dark:text-neutral-400";

      if (r.mode === "structured") {
        const grid = document.createElement("div");
        grid.className = "grid gap-3 pr-6 sm:grid-cols-2";
        const field = (label: string, name: keyof PubRow, placeholder: string, value: string, span2 = false) => {
          const wrap = document.createElement("div");
          if (span2) wrap.className = "sm:col-span-2";
          const lab = document.createElement("span");
          lab.className = "block text-xs font-medium text-neutral-500 dark:text-neutral-400";
          lab.textContent = label;
          const inp = document.createElement("input");
          inp.type = "text";
          inp.placeholder = placeholder;
          inp.value = value;
          inp.className =
            "mt-1 w-full rounded border border-neutral-300 dark:border-neutral-600 bg-white dark:bg-neutral-800 px-2.5 py-1.5 text-sm text-neutral-900 dark:text-neutral-100 focus:border-blue-500 focus:outline-none";
          inp.addEventListener("input", () => {
            (r[name] as string) = inp.value;
            preview.textContent = pubCitation(r) || "Citation preview";
          });
          wrap.appendChild(lab);
          wrap.appendChild(inp);
          grid.appendChild(wrap);
        };
        field("Authors", "authors", "A. Banik, Q. M. R. Nizam", r.authors, true);
        field("Title", "title", "Paper title", r.title, true);
        field("Venue", "venue", "Journal name", r.venue);
        field("Year", "year", "2026", r.year);
        row.appendChild(grid);
        preview.textContent = pubCitation(r) || "Citation preview";
        row.appendChild(preview);
      } else {
        const ta = document.createElement("textarea");
        ta.rows = 2;
        ta.placeholder = "Paste a full citation";
        ta.value = r.text;
        ta.className =
          "mt-1 w-full rounded border border-neutral-300 dark:border-neutral-600 bg-white dark:bg-neutral-800 px-2.5 py-1.5 pr-8 text-sm text-neutral-900 dark:text-neutral-100 focus:border-blue-500 focus:outline-none";
        ta.addEventListener("input", () => {
          r.text = ta.value;
          preview.textContent = pubCitation(r) || "Citation preview";
        });
        row.appendChild(ta);
        preview.textContent = pubCitation(r) || "Citation preview";
        row.appendChild(preview);
      }
      pubsEditor.appendChild(row);
    }
  }

  pubsAdd.addEventListener("click", () => {
    pubRows.push({ id: pubId++, mode: "structured", authors: "", title: "", venue: "", year: "", text: "" });
    renderPubs();
  });
  renderPubs();

  function valueOf(name: string): string {
    return (form.elements.namedItem(name) as HTMLInputElement | HTMLTextAreaElement)?.value ?? "";
  }

  form.addEventListener("submit", async (e) => {
    e.preventDefault();
    errorEl.classList.add("hidden");

    const links = valueOf("links")
      .split("\n")
      .map((line) => line.split("::").map((s) => s.trim()))
      .filter((parts) => parts.length === 2 && parts[0] && parts[1])
      .map(([label, url]) => ({ label, url }));

    const category = alumniRadio.checked ? "alumni" : "member";
    const year = valueOf("yearGraduated").trim();

    const payload = {
      category,
      name: valueOf("name"),
      image: avatarUrlInput.value || undefined,
      role: valueOf("role") || undefined,
      focus: valueOf("focus") || undefined,
      email: valueOf("email") || undefined,
      bio: valueOf("bio") || undefined,
      website: valueOf("website") || undefined,
      scholar: valueOf("scholar") || undefined,
      linkedin: valueOf("linkedin") || undefined,
      github: valueOf("github") || undefined,
      currentPosition: category === "alumni" ? (valueOf("currentPosition") || undefined) : undefined,
      currentInstitution: category === "alumni" ? (valueOf("currentInstitution") || undefined) : undefined,
      yearGraduated: category === "alumni" && year ? Number(year) : undefined,
      links,
      publications: pubRows.map(pubCitation).filter(Boolean),
    };

    const res = await fetch("/api/members", {
      method: "POST",
      headers: { "Content-Type": "application/json" },
      body: JSON.stringify(payload),
    });

    if (res.ok) {
      location.href = "/account";
    } else {
      const data = await res.json().catch(() => null);
      errorEl.textContent = data?.error ?? "Could not submit the profile.";
      errorEl.classList.remove("hidden");
    }
  });
</script>
