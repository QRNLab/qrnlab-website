---
import BaseLayout from "../../layouts/BaseLayout.astro";

export const prerender = false;
---

<BaseLayout title="Education editor" description="Manage lecture notes, presentations and posters">
  <div class="flex items-center justify-between gap-4">
    <div>
      <h1 class="text-3xl font-semibold tracking-tight">Education</h1>
      <p class="mt-1 text-sm text-neutral-500 dark:text-neutral-400">
        Add lecture notes, presentations and posters. Entries can carry custom links and embedded YouTube videos; publishing syncs them into the Education page.
      </p>
    </div>
    <button id="new-entry" class="shrink-0 rounded bg-[#0b0d39] dark:bg-[#f4f2c7] px-4 py-2 text-sm font-medium text-white dark:text-[#0b0d39] hover:opacity-90 transition-opacity">New entry</button>
  </div>

  <div id="list" class="mt-8 space-y-6"></div>

  <section id="editor" class="mt-10 hidden">
    <h2 id="editor-title" class="text-2xl font-medium tracking-tight border-b border-neutral-200 dark:border-neutral-700 pb-2">New entry</h2>

    <form id="entry-form" class="mt-6 max-w-2xl space-y-4" novalidate>
      <input type="hidden" id="entry-id" />
      <div class="grid gap-4 sm:grid-cols-2">
        <div>
          <label for="section" class="block text-sm font-medium text-neutral-700 dark:text-neutral-300">Section</label>
          <select id="section"
            class="mt-1 w-full rounded border border-neutral-300 dark:border-neutral-600 bg-white dark:bg-neutral-800 px-3 py-2 text-sm text-neutral-900 dark:text-neutral-100 focus:border-blue-500 focus:outline-none">
            <option value="lecture-notes">Lecture Notes</option>
            <option value="presentations">Presentations</option>
            <option value="posters">Posters</option>
          </select>
        </div>
        <div>
          <label for="heading" class="block text-sm font-medium text-neutral-700 dark:text-neutral-300">Heading</label>
          <input id="heading" type="text" required placeholder="e.g. Introduction to Radiation Physics"
            class="mt-1 w-full rounded border border-neutral-300 dark:border-neutral-600 bg-white dark:bg-neutral-800 px-3 py-2 text-sm text-neutral-900 dark:text-neutral-100 focus:border-blue-500 focus:outline-none" />
        </div>
      </div>

      <div>
        <label for="description" class="block text-sm font-medium text-neutral-700 dark:text-neutral-300">Description <span class="font-normal text-neutral-400 dark:text-neutral-500">(optional)</span></label>
        <textarea id="description" rows={4}
          class="mt-1 w-full rounded border border-neutral-300 dark:border-neutral-600 bg-white dark:bg-neutral-800 px-3 py-2 text-sm text-neutral-900 dark:text-neutral-100 focus:border-blue-500 focus:outline-none"></textarea>
      </div>

      <div>
        <span class="block text-sm font-medium text-neutral-700 dark:text-neutral-300">Links <span class="font-normal text-neutral-400 dark:text-neutral-500">(optional)</span></span>
        <div id="links-list" class="mt-1 space-y-2"></div>
        <button type="button" id="links-add"
          class="mt-2 inline-flex items-center gap-1.5 rounded border border-neutral-300 dark:border-neutral-600 px-3 py-1.5 text-sm text-neutral-700 dark:text-neutral-300 hover:bg-neutral-100 dark:hover:bg-neutral-800 transition-colors">
          <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><line x1="12" y1="5" x2="12" y2="19"/><line x1="5" y1="12" x2="19" y2="12"/></svg>
          Add link
        </button>
      </div>

      <div>
        <span class="block text-sm font-medium text-neutral-700 dark:text-neutral-300">YouTube videos <span class="font-normal text-neutral-400 dark:text-neutral-500">(optional — embedded on the Education page)</span></span>
        <div id="youtube-list" class="mt-1 space-y-2"></div>
        <button type="button" id="youtube-add"
          class="mt-2 inline-flex items-center gap-1.5 rounded border border-neutral-300 dark:border-neutral-600 px-3 py-1.5 text-sm text-neutral-700 dark:text-neutral-300 hover:bg-neutral-100 dark:hover:bg-neutral-800 transition-colors">
          <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><line x1="12" y1="5" x2="12" y2="19"/><line x1="5" y1="12" x2="19" y2="12"/></svg>
          Add video
        </button>
      </div>

      <div>
        <span class="block text-sm font-medium text-neutral-700 dark:text-neutral-300">Images <span class="font-normal text-neutral-400 dark:text-neutral-500">(optional)</span></span>
        <div id="images-list" class="mt-2 grid grid-cols-2 gap-3 sm:grid-cols-3"></div>
        <div class="mt-2 flex items-center gap-3">
          <button type="button" id="image-add"
            class="inline-flex items-center gap-1.5 rounded border border-neutral-300 dark:border-neutral-600 px-3 py-1.5 text-sm text-neutral-700 dark:text-neutral-300 hover:bg-neutral-100 dark:hover:bg-neutral-800 transition-colors">
            <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><line x1="12" y1="5" x2="12" y2="19"/><line x1="5" y1="12" x2="19" y2="12"/></svg>
            Upload image
          </button>
          <input id="image-input" type="file" accept="image/jpeg,image/png,image/webp,image/gif,image/avif" class="sr-only" />
          <span id="image-status" class="text-xs text-neutral-400 dark:text-neutral-500"></span>
        </div>
      </div>

      <div class="flex flex-wrap gap-2">
        <button type="submit" class="rounded bg-[#0b0d39] dark:bg-[#f4f2c7] px-4 py-2 text-sm font-medium text-white dark:text-[#0b0d39] hover:opacity-90 transition-opacity">Save draft</button>
        <button type="button" id="publish-btn" class="rounded bg-green-700 dark:bg-green-600 px-4 py-2 text-sm font-medium text-white hover:opacity-90 transition-opacity">Publish</button>
        <button type="button" id="cancel-btn" class="rounded border border-neutral-300 dark:border-neutral-600 px-4 py-2 text-sm text-neutral-700 dark:text-neutral-300 hover:bg-neutral-100 dark:hover:bg-neutral-800 transition-colors">Cancel</button>
      </div>

      <p id="error" class="hidden text-sm text-red-600 dark:text-red-400"></p>
      <p id="done" class="hidden text-sm text-green-700 dark:text-green-400"></p>
    </form>
  </section>
</BaseLayout>

<script>
  import { api } from "../../lib/client/api";

  const listEl = document.getElementById("list")!;
  const editorEl = document.getElementById("editor")!;
  const editorTitle = document.getElementById("editor-title")!;
  const form = document.getElementById("entry-form") as HTMLFormElement;
  const idInput = document.getElementById("entry-id") as HTMLInputElement;
  const errorEl = document.getElementById("error")!;
  const doneEl = document.getElementById("done")!;
  const linksList = document.getElementById("links-list")!;
  const linksAdd = document.getElementById("links-add")!;
  const youtubeList = document.getElementById("youtube-list")!;
  const youtubeAdd = document.getElementById("youtube-add")!;
  const imagesList = document.getElementById("images-list")!;
  const imageAdd = document.getElementById("image-add")!;
  const imageInput = document.getElementById("image-input") as HTMLInputElement;
  const imageStatus = document.getElementById("image-status")!;

  const SECTION_LABELS: Record<string, string> = {
    "lecture-notes": "Lecture Notes",
    presentations: "Presentations",
    posters: "Posters",
  };

  interface LinkRow { id: number; label: string; url: string; }
  interface YoutubeRow { id: number; url: string; }

  let entries: any[] = [];
  let links: LinkRow[] = [];
  let youtubes: YoutubeRow[] = [];
  let images: string[] = [];
  let rowId = 0;
  let editingId: string | null = null;

  function renderLinks() {
    linksList.innerHTML = "";
    for (const l of links) {
      const row = document.createElement("div");
      row.className = "flex items-center gap-2";
      const label = document.createElement("input");
      label.type = "text";
      label.placeholder = "Label";
      label.value = l.label;
      label.className =
        "min-w-0 flex-1 rounded border border-neutral-300 dark:border-neutral-600 bg-white dark:bg-neutral-800 px-3 py-2 text-sm text-neutral-900 dark:text-neutral-100 focus:border-blue-500 focus:outline-none";
      label.addEventListener("input", () => { l.label = label.value; });
      const url = document.createElement("input");
      url.type = "url";
      url.placeholder = "https://...";
      url.value = l.url;
      url.className =
        "min-w-0 flex-1 rounded border border-neutral-300 dark:border-neutral-600 bg-white dark:bg-neutral-800 px-3 py-2 text-sm text-neutral-900 dark:text-neutral-100 focus:border-blue-500 focus:outline-none";
      url.addEventListener("input", () => { l.url = url.value; });
      const remove = document.createElement("button");
      remove.type = "button";
      remove.className = "shrink-0 rounded p-1 text-neutral-400 hover:text-red-500 transition-colors";
      remove.setAttribute("aria-label", "Remove link");
      remove.innerHTML =
        '<svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><line x1="18" y1="6" x2="6" y2="18"/><line x1="6" y1="6" x2="18" y2="18"/></svg>';
      remove.addEventListener("click", () => {
        links = links.filter((x) => x.id !== l.id);
        renderLinks();
      });
      row.appendChild(label);
      row.appendChild(url);
      row.appendChild(remove);
      linksList.appendChild(row);
    }
  }

  function renderYoutubes() {
    youtubeList.innerHTML = "";
    for (const y of youtubes) {
      const row = document.createElement("div");
      row.className = "flex items-center gap-2";
      const url = document.createElement("input");
      url.type = "url";
      url.placeholder = "https://www.youtube.com/watch?v=...";
      url.value = y.url;
      url.className =
        "min-w-0 flex-1 rounded border border-neutral-300 dark:border-neutral-600 bg-white dark:bg-neutral-800 px-3 py-2 text-sm text-neutral-900 dark:text-neutral-100 focus:border-blue-500 focus:outline-none";
      url.addEventListener("input", () => { y.url = url.value; });
      const remove = document.createElement("button");
      remove.type = "button";
      remove.className = "shrink-0 rounded p-1 text-neutral-400 hover:text-red-500 transition-colors";
      remove.setAttribute("aria-label", "Remove video");
      remove.innerHTML =
        '<svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><line x1="18" y1="6" x2="6" y2="18"/><line x1="6" y1="6" x2="18" y2="18"/></svg>';
      remove.addEventListener("click", () => {
        youtubes = youtubes.filter((x) => x.id !== y.id);
        renderYoutubes();
      });
      row.appendChild(url);
      row.appendChild(remove);
      youtubeList.appendChild(row);
    }
  }

  function renderImages() {
    imagesList.innerHTML = "";
    if (images.length === 0) {
      imagesList.innerHTML = '<p class="col-span-full text-xs text-neutral-400 dark:text-neutral-500 italic">No images yet.</p>';
      return;
    }
    for (const key of images) {
      const card = document.createElement("div");
      card.className = "group relative overflow-hidden rounded-lg border border-neutral-200 dark:border-neutral-700";
      const img = document.createElement("img");
      img.src = `/media/${key}`;
      img.alt = "Uploaded image";
      img.loading = "lazy";
      img.className = "h-24 w-full object-cover bg-neutral-100 dark:bg-neutral-800";
      const remove = document.createElement("button");
      remove.type = "button";
      remove.className = "absolute right-1.5 top-1.5 rounded bg-black/60 p-1 text-white opacity-0 transition-opacity group-hover:opacity-100";
      remove.setAttribute("aria-label", "Remove image");
      remove.innerHTML =
        '<svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><line x1="18" y1="6" x2="6" y2="18"/><line x1="6" y1="6" x2="18" y2="18"/></svg>';
      remove.addEventListener("click", async () => {
        if (!confirm("Remove this image? It will be deleted from storage.")) return;
        try {
          await api(`/media/key/${key}`, { method: "DELETE" });
          images = images.filter((k) => k !== key);
          renderImages();
        } catch (err: any) {
          errorEl.textContent = err.message ?? "Could not remove image.";
          errorEl.classList.remove("hidden");
        }
      });
      card.appendChild(img);
      card.appendChild(remove);
      imagesList.appendChild(card);
    }
  }

  async function uploadImage(file: File) {
    const form = new FormData();
    form.append("file", file);
    form.append("purpose", "education");
    const data = await api<{ key: string }>("/media", { method: "POST", body: form, headers: {} });
    return data.key;
  }

  function valueOf(name: string): string {
    return (form.elements.namedItem(name) as HTMLInputElement | HTMLSelectElement)?.value ?? "";
  }

  async function load() {
    const data = await api<{ entries: any[] }>("/content/education");
    entries = data.entries ?? [];
    renderList();
  }

  function renderList() {
    listEl.innerHTML = "";
    if (entries.length === 0) {
      listEl.innerHTML = '<p class="text-sm text-neutral-500 dark:text-neutral-400 italic">No education entries yet. Add your first one!</p>';
      return;
    }
    for (const section of ["lecture-notes", "presentations", "posters"]) {
      const sectionEntries = entries.filter((e) => e.section === section);
      if (sectionEntries.length === 0) continue;
      const group = document.createElement("div");
      const header = document.createElement("h2");
      header.className = "text-lg font-medium tracking-tight border-b border-neutral-200 dark:border-neutral-700 pb-2";
      header.textContent = SECTION_LABELS[section];
      group.appendChild(header);
      const rows = document.createElement("div");
      rows.className = "mt-3 space-y-3";
      for (const entry of sectionEntries) {
        const row = document.createElement("div");
        row.className = "flex items-center justify-between gap-4 rounded-lg border border-neutral-200 dark:border-neutral-700 p-4";
        const info = document.createElement("div");
        info.className = "min-w-0";
        const title = document.createElement("p");
        title.className = "font-medium text-neutral-900 dark:text-neutral-100 truncate";
        title.textContent = entry.heading;
        const meta = document.createElement("p");
        meta.className = "text-xs text-neutral-500 dark:text-neutral-400";
        meta.textContent = `${entry.status} · ${new Date(entry.updatedAt).toLocaleString()} · ${(entry.links ?? []).length} links · ${(entry.youtubeLinks ?? []).length} videos · ${(entry.images ?? []).length} images`;
        info.appendChild(title);
        info.appendChild(meta);
        const actions = document.createElement("div");
        actions.className = "flex shrink-0 items-center gap-2";
        const moveUp = document.createElement("button");
        moveUp.className = "rounded border border-neutral-300 dark:border-neutral-600 px-2 py-1 text-xs text-neutral-500 dark:text-neutral-400 hover:bg-neutral-100 dark:hover:bg-neutral-800 disabled:opacity-40 transition-colors";
        moveUp.innerHTML = '<svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="18 15 12 9 6 15"/></svg>';
        moveUp.setAttribute("aria-label", "Move up");
        moveUp.disabled = entry === sectionEntries[0];
        moveUp.addEventListener("click", () => move(entry.id, "up"));
        const moveDown = document.createElement("button");
        moveDown.className = "rounded border border-neutral-300 dark:border-neutral-600 px-2 py-1 text-xs text-neutral-500 dark:text-neutral-400 hover:bg-neutral-100 dark:hover:bg-neutral-800 disabled:opacity-40 transition-colors";
        moveDown.innerHTML = '<svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="6 9 12 15 18 9"/></svg>';
        moveDown.setAttribute("aria-label", "Move down");
        moveDown.disabled = entry === sectionEntries[sectionEntries.length - 1];
        moveDown.addEventListener("click", () => move(entry.id, "down"));
        const editBtn = document.createElement("button");
        editBtn.className = "rounded border border-neutral-300 dark:border-neutral-600 px-3 py-1 text-xs text-neutral-700 dark:text-neutral-300 hover:bg-neutral-100 dark:hover:bg-neutral-800 transition-colors";
        editBtn.textContent = "Edit";
        editBtn.addEventListener("click", () => openEdit(entry));
        const pubBtn = document.createElement("button");
        pubBtn.className = "rounded bg-green-700 dark:bg-green-600 px-3 py-1 text-xs text-white hover:opacity-90 transition-opacity";
        pubBtn.textContent = entry.status === "published" ? "Republish" : "Publish";
        pubBtn.addEventListener("click", () => publish(entry.id));
        const delBtn = document.createElement("button");
        delBtn.className = "rounded border border-red-300 dark:border-red-700 px-3 py-1 text-xs text-red-600 dark:text-red-400 hover:bg-red-50 dark:hover:bg-red-950/30 transition-colors";
        delBtn.textContent = "Delete";
        delBtn.addEventListener("click", () => removeEntry(entry));
        actions.appendChild(moveUp);
        actions.appendChild(moveDown);
        actions.appendChild(editBtn);
        actions.appendChild(pubBtn);
        actions.appendChild(delBtn);
        row.appendChild(info);
        row.appendChild(actions);
        rows.appendChild(row);
      }
      group.appendChild(rows);
      listEl.appendChild(group);
    }
  }

  function openNew() {
    editingId = null;
    idInput.value = "";
    (form.elements.namedItem("section") as HTMLSelectElement).value = "lecture-notes";
    (form.elements.namedItem("heading") as HTMLInputElement).value = "";
    (form.elements.namedItem("description") as HTMLTextAreaElement).value = "";
    links = [];
    youtubes = [];
    images = [];
    rowId = 0;
    renderLinks();
    renderYoutubes();
    renderImages();
    errorEl.classList.add("hidden");
    doneEl.classList.add("hidden");
    editorTitle.textContent = "New entry";
    editorEl.classList.remove("hidden");
    editorEl.scrollIntoView({ behavior: "smooth" });
  }

  function openEdit(entry: any) {
    editingId = entry.id;
    idInput.value = entry.id;
    (form.elements.namedItem("section") as HTMLSelectElement).value = entry.section;
    (form.elements.namedItem("heading") as HTMLInputElement).value = entry.heading;
    (form.elements.namedItem("description") as HTMLTextAreaElement).value = entry.description ?? "";
    links = (entry.links ?? []).map((l: any) => ({ id: rowId++, label: l.label, url: l.url }));
    youtubes = (entry.youtubeLinks ?? []).map((u: string) => ({ id: rowId++, url: u }));
    images = (entry.images ?? []).slice();
    renderLinks();
    renderYoutubes();
    renderImages();
    errorEl.classList.add("hidden");
    doneEl.classList.add("hidden");
    editorTitle.textContent = `Edit: ${entry.heading}`;
    editorEl.classList.remove("hidden");
    editorEl.scrollIntoView({ behavior: "smooth" });
  }

  async function save() {
    errorEl.classList.add("hidden");
    doneEl.classList.add("hidden");
    const payload = {
      section: valueOf("section"),
      heading: valueOf("heading"),
      description: valueOf("description") || undefined,
      links: links
        .map((l) => ({ label: l.label.trim(), url: l.url.trim() }))
        .filter((l) => l.label && l.url),
      youtubeLinks: youtubes.map((y) => y.url.trim()).filter(Boolean),
      images,
    };
    try {
      if (editingId) {
        await api(`/content/education/${editingId}`, { method: "PUT", body: JSON.stringify(payload) });
      } else {
        const data = await api<{ id: string }>("/content/education", { method: "POST", body: JSON.stringify(payload) });
        editingId = data.id;
        idInput.value = data.id;
      }
      doneEl.textContent = "Draft saved.";
      doneEl.classList.remove("hidden");
      await load();
    } catch (err: any) {
      errorEl.textContent = err.message ?? "Could not save.";
      errorEl.classList.remove("hidden");
    }
  }

  async function publish(id: string) {
    errorEl.classList.add("hidden");
    doneEl.classList.add("hidden");
    try {
      await api(`/content/education/${id}/publish`, { method: "POST" });
      doneEl.textContent = "Published.";
      doneEl.classList.remove("hidden");
      await load();
    } catch (err: any) {
      errorEl.textContent = err.message ?? "Publish failed.";
      errorEl.classList.remove("hidden");
    }
  }

  async function move(id: string, direction: "up" | "down") {
    errorEl.classList.add("hidden");
    doneEl.classList.add("hidden");
    try {
      await api(`/content/education/${id}/move`, {
        method: "POST",
        body: JSON.stringify({ direction }),
      });
      await load();
    } catch (err: any) {
      errorEl.textContent = err.message ?? "Could not reorder.";
      errorEl.classList.remove("hidden");
    }
  }

  async function removeEntry(entry: any) {
    if (!confirm(`Delete "${entry.heading}"? Its images will also be removed.`)) return;
    errorEl.classList.add("hidden");
    doneEl.classList.add("hidden");
    try {
      await api(`/content/education/${entry.id}`, { method: "DELETE" });
      for (const key of entry.images ?? []) {
        await api(`/media/key/${key}`, { method: "DELETE" }).catch(() => {});
      }
      if (editingId === entry.id) {
        editorEl.classList.add("hidden");
      }
      doneEl.textContent = "Deleted.";
      doneEl.classList.remove("hidden");
      await load();
    } catch (err: any) {
      errorEl.textContent = err.message ?? "Could not delete.";
      errorEl.classList.remove("hidden");
    }
  }

  linksAdd.addEventListener("click", () => {
    links.push({ id: rowId++, label: "", url: "" });
    renderLinks();
  });
  youtubeAdd.addEventListener("click", () => {
    youtubes.push({ id: rowId++, url: "" });
    renderYoutubes();
  });
  imageAdd.addEventListener("click", () => imageInput.click());
  imageInput.addEventListener("change", async () => {
    const file = imageInput.files?.[0];
    if (!file) return;
    errorEl.classList.add("hidden");
    imageStatus.textContent = "Uploading…";
    try {
      const key = await uploadImage(file);
      images.push(key);
      renderImages();
      imageStatus.textContent = "Uploaded.";
    } catch (err: any) {
      errorEl.textContent = err.message ?? "Upload failed.";
      errorEl.classList.remove("hidden");
      imageStatus.textContent = "";
    }
    imageInput.value = "";
    setTimeout(() => (imageStatus.textContent = ""), 2500);
  });
  form.addEventListener("submit", (e) => {
    e.preventDefault();
    save();
  });
  document.getElementById("publish-btn")!.addEventListener("click", async () => {
    if (!editingId) {
      await save();
    }
    if (editingId) await publish(editingId);
  });
  document.getElementById("cancel-btn")!.addEventListener("click", () => {
    editorEl.classList.add("hidden");
  });
  document.getElementById("new-entry")!.addEventListener("click", openNew);

  load();
</script>
