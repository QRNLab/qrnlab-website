---
import BaseLayout from "../../layouts/BaseLayout.astro";

export const prerender = false;
---

<BaseLayout title="Publications editor" description="Manage lab publications">
  <div class="flex items-center justify-between gap-4">
    <div>
      <h1 class="text-3xl font-semibold tracking-tight">Publications</h1>
      <p class="mt-1 text-sm text-neutral-500 dark:text-neutral-400">
        Add a publication, or link its authors to lab members/alumni. Publishing syncs it into the Publications page.
      </p>
    </div>
    <button id="new-pub" class="shrink-0 rounded bg-[#0b0d39] dark:bg-[#f4f2c7] px-4 py-2 text-sm font-medium text-white dark:text-[#0b0d39] hover:opacity-90 transition-opacity">New publication</button>
  </div>

  <div id="list" class="mt-8 space-y-3"></div>

  <section id="editor" class="mt-10 hidden">
    <h2 id="editor-title" class="text-2xl font-medium tracking-tight border-b border-neutral-200 dark:border-neutral-700 pb-2">New publication</h2>

    <form id="pub-form" class="mt-6 max-w-2xl space-y-4" novalidate>
      <input type="hidden" id="pub-id" />
      <div>
        <label for="title" class="block text-sm font-medium text-neutral-700 dark:text-neutral-300">Title</label>
        <input id="title" type="text" required placeholder="Full paper title"
          class="mt-1 w-full rounded border border-neutral-300 dark:border-neutral-600 bg-white dark:bg-neutral-800 px-3 py-2 text-sm text-neutral-900 dark:text-neutral-100 focus:border-blue-500 focus:outline-none" />
      </div>

      <div>
        <span class="block text-sm font-medium text-neutral-700 dark:text-neutral-300">Authors</span>
        <div id="authors-list" class="mt-1 space-y-2"></div>
        <button type="button" id="authors-add"
          class="mt-2 inline-flex items-center gap-1.5 rounded border border-neutral-300 dark:border-neutral-600 px-3 py-1.5 text-sm text-neutral-700 dark:text-neutral-300 hover:bg-neutral-100 dark:hover:bg-neutral-800 transition-colors">
          <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><line x1="12" y1="5" x2="12" y2="19"/><line x1="5" y1="12" x2="19" y2="12"/></svg>
          Add author
        </button>
      </div>

      <div class="grid gap-4 sm:grid-cols-3">
        <div>
          <label for="venue" class="block text-sm font-medium text-neutral-700 dark:text-neutral-300">Venue</label>
          <input id="venue" type="text" required placeholder="Journal of Radiological Protection, 46, 011002"
            class="mt-1 w-full rounded border border-neutral-300 dark:border-neutral-600 bg-white dark:bg-neutral-800 px-3 py-2 text-sm text-neutral-900 dark:text-neutral-100 focus:border-blue-500 focus:outline-none" />
        </div>
        <div>
          <label for="year" class="block text-sm font-medium text-neutral-700 dark:text-neutral-300">Year</label>
          <input id="year" type="number" required min={1900} max={2100} value="2026"
            class="mt-1 w-full rounded border border-neutral-300 dark:border-neutral-600 bg-white dark:bg-neutral-800 px-3 py-2 text-sm text-neutral-900 dark:text-neutral-100 focus:border-blue-500 focus:outline-none" />
        </div>
        <div>
          <label for="type" class="block text-sm font-medium text-neutral-700 dark:text-neutral-300">Type</label>
          <select id="type"
            class="mt-1 w-full rounded border border-neutral-300 dark:border-neutral-600 bg-white dark:bg-neutral-800 px-3 py-2 text-sm text-neutral-900 dark:text-neutral-100">
            <option value="journal">Journal</option>
            <option value="conference">Conference</option>
            <option value="preprint">Preprint</option>
          </select>
        </div>
      </div>

      <div>
        <label for="url" class="block text-sm font-medium text-neutral-700 dark:text-neutral-300">URL <span class="font-normal text-neutral-400 dark:text-neutral-500">(optional)</span></label>
        <input id="url" type="url" placeholder="https://doi.org/..."
          class="mt-1 w-full rounded border border-neutral-300 dark:border-neutral-600 bg-white dark:bg-neutral-800 px-3 py-2 text-sm text-neutral-900 dark:text-neutral-100 focus:border-blue-500 focus:outline-none" />
      </div>

      <div class="rounded-lg border border-neutral-200 dark:border-neutral-700 bg-neutral-50 dark:bg-neutral-800/40 p-3">
        <p class="text-xs font-medium text-neutral-500 dark:text-neutral-400">Citation preview</p>
        <p id="preview" class="mt-1 text-sm text-neutral-700 dark:text-neutral-300 leading-relaxed">—</p>
      </div>

      <div class="flex flex-wrap gap-2">
        <button type="submit" class="rounded bg-[#0b0d39] dark:bg-[#f4f2c7] px-4 py-2 text-sm font-medium text-white dark:text-[#0b0d39] hover:opacity-90 transition-opacity">Save draft</button>
        <button type="button" id="publish-btn" class="rounded bg-green-700 dark:bg-green-600 px-4 py-2 text-sm font-medium text-white hover:opacity-90 transition-opacity">Publish</button>
        <button type="button" id="cancel-btn" class="rounded border border-neutral-300 dark:border-neutral-600 px-4 py-2 text-sm text-neutral-700 dark:text-neutral-300 hover:bg-neutral-100 dark:hover:bg-neutral-800 transition-colors">Cancel</button>
      </div>

      <p id="error" class="hidden text-sm text-red-600 dark:text-red-400"></p>
      <p id="done" class="hidden text-sm text-green-700 dark:text-green-400"></p>
    </form>
  </section>
</BaseLayout>

<script>
  import { api } from "../../lib/client/api";

  const listEl = document.getElementById("list")!;
  const editorEl = document.getElementById("editor")!;
  const editorTitle = document.getElementById("editor-title")!;
  const form = document.getElementById("pub-form") as HTMLFormElement;
  const idInput = document.getElementById("pub-id") as HTMLInputElement;
  const errorEl = document.getElementById("error")!;
  const doneEl = document.getElementById("done")!;
  const previewEl = document.getElementById("preview")!;
  const authorsList = document.getElementById("authors-list")!;
  const authorsAdd = document.getElementById("authors-add")!;

  interface AuthorRow {
    id: number;
    name: string;
    memberSlug?: string;
  }
  let publications: any[] = [];
  let authors: AuthorRow[] = [];
  let authorId = 0;
  let editingId: string | null = null;
  let teamMembers: { slug: string; name: string; category: string }[] = [];

  function renderAuthors() {
    authorsList.innerHTML = "";
    for (const a of authors) {
      const row = document.createElement("div");
      row.className = "flex items-center gap-2";
      const inp = document.createElement("input");
      inp.type = "text";
      inp.placeholder = "e.g. A. Banik";
      inp.value = a.name;
      inp.className =
        "min-w-0 flex-1 rounded border border-neutral-300 dark:border-neutral-600 bg-white dark:bg-neutral-800 px-3 py-2 text-sm text-neutral-900 dark:text-neutral-100 focus:border-blue-500 focus:outline-none";
      inp.addEventListener("input", () => {
        a.name = inp.value;
        updatePreview();
      });
      const sel = document.createElement("select");
      sel.className =
        "shrink-0 rounded border border-neutral-300 dark:border-neutral-600 bg-white dark:bg-neutral-800 px-2 py-2 text-sm text-neutral-900 dark:text-neutral-100 focus:border-blue-500 focus:outline-none";
      const none = document.createElement("option");
      none.value = "";
      none.textContent = "— Static name (no link) —";
      sel.appendChild(none);
      for (const m of teamMembers) {
        const opt = document.createElement("option");
        opt.value = m.slug;
        opt.textContent = `${m.name} (${m.category})`;
        sel.appendChild(opt);
      }
      sel.value = a.memberSlug ?? "";
      sel.addEventListener("change", () => {
        a.memberSlug = sel.value || undefined;
      });
      const remove = document.createElement("button");
      remove.type = "button";
      remove.className = "shrink-0 rounded p-1 text-neutral-400 hover:text-red-500 transition-colors";
      remove.setAttribute("aria-label", "Remove author");
      remove.innerHTML =
        '<svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><line x1="18" y1="6" x2="6" y2="18"/><line x1="6" y1="6" x2="18" y2="18"/></svg>';
      remove.addEventListener("click", () => {
        authors = authors.filter((x) => x.id !== a.id);
        renderAuthors();
        updatePreview();
      });
      row.appendChild(inp);
      row.appendChild(sel);
      row.appendChild(remove);
      authorsList.appendChild(row);
    }
  }

  async function loadTeam() {
    try {
      const data = await api<{ team: { slug: string; name: string; category: string }[] }>("/content/team");
      teamMembers = data.team ?? [];
    } catch {
      teamMembers = [];
    }
  }

  function valueOf(name: string): string {
    return (form.elements.namedItem(name) as HTMLInputElement | HTMLSelectElement)?.value ?? "";
  }

  function updatePreview() {
    const authorsText = authors.map((a) => a.name.trim()).filter(Boolean).join(", ");
    const title = valueOf("title").trim();
    const venue = valueOf("venue").trim();
    const year = valueOf("year").trim();
    const venueYear = [venue, year].filter(Boolean).join(", ");
    let c = [authorsText, title ? `"${title}."` : "", venueYear].filter(Boolean).join(" ");
    if (c && !/[.!?]$/.test(c)) c += ".";
    previewEl.textContent = c || "—";
  }

  async function load() {
    const data = await api<{ publications: any[] }>("/content/publications");
    publications = data.publications ?? [];
    renderList();
  }

  function renderList() {
    listEl.innerHTML = "";
    if (publications.length === 0) {
      listEl.innerHTML = '<p class="text-sm text-neutral-500 dark:text-neutral-400 italic">No publications yet. Add your first one!</p>';
      return;
    }
    for (const pub of publications) {
      const row = document.createElement("div");
      row.className = "flex items-center justify-between gap-4 rounded-lg border border-neutral-200 dark:border-neutral-700 p-4";
      const info = document.createElement("div");
      info.innerHTML = `
        <p class="font-medium text-neutral-900 dark:text-neutral-100"></p>
        <p class="text-xs text-neutral-500 dark:text-neutral-400"></p>`;
      info.querySelector("p")!.textContent = pub.title;
      const meta = info.querySelectorAll("p")[1];
      meta.textContent = `${pub.status} · ${new Date(pub.updatedAt).toLocaleString()} · ${(pub.authors ?? []).map((a: any) => a.name).join(", ")}`;
      const actions = document.createElement("div");
      actions.className = "flex gap-2";
      const editBtn = document.createElement("button");
      editBtn.className = "rounded border border-neutral-300 dark:border-neutral-600 px-3 py-1 text-xs text-neutral-700 dark:text-neutral-300 hover:bg-neutral-100 dark:hover:bg-neutral-800 transition-colors";
      editBtn.textContent = "Edit";
      editBtn.addEventListener("click", () => openEdit(pub));
      actions.appendChild(editBtn);
      const pubBtn = document.createElement("button");
      pubBtn.className = "rounded bg-green-700 dark:bg-green-600 px-3 py-1 text-xs text-white hover:opacity-90 transition-opacity";
      pubBtn.textContent = pub.status === "published" ? "Republish" : "Publish";
      pubBtn.addEventListener("click", () => publish(pub.id));
      actions.appendChild(pubBtn);
      const delBtn = document.createElement("button");
      delBtn.className = "rounded border border-red-300 dark:border-red-700 px-3 py-1 text-xs text-red-600 dark:text-red-400 hover:bg-red-50 dark:hover:bg-red-950/30 transition-colors";
      delBtn.textContent = "Delete";
      delBtn.addEventListener("click", () => removePub(pub));
      actions.appendChild(delBtn);
      row.appendChild(info);
      row.appendChild(actions);
      listEl.appendChild(row);
    }
  }

  function openNew() {
    editingId = null;
    idInput.value = "";
    (form.elements.namedItem("title") as HTMLInputElement).value = "";
    (form.elements.namedItem("venue") as HTMLInputElement).value = "";
    (form.elements.namedItem("year") as HTMLInputElement).value = "2026";
    (form.elements.namedItem("type") as HTMLSelectElement).value = "journal";
    (form.elements.namedItem("url") as HTMLInputElement).value = "";
    authors = [];
    authorId = 0;
    renderAuthors();
    errorEl.classList.add("hidden");
    doneEl.classList.add("hidden");
    editorTitle.textContent = "New publication";
    editorEl.classList.remove("hidden");
    updatePreview();
  }

  function openEdit(pub: any) {
    editingId = pub.id;
    idInput.value = pub.id;
    (form.elements.namedItem("title") as HTMLInputElement).value = pub.title;
    (form.elements.namedItem("venue") as HTMLInputElement).value = pub.venue;
    (form.elements.namedItem("year") as HTMLInputElement).value = String(pub.year);
    (form.elements.namedItem("type") as HTMLSelectElement).value = pub.type;
    (form.elements.namedItem("url") as HTMLInputElement).value = pub.url ?? "";
    authors = (pub.authors ?? []).map((a: any, i: number) => ({
      id: i,
      name: a.name,
      memberSlug: a.memberSlug,
    }));
    authorId = authors.length;
    renderAuthors();
    errorEl.classList.add("hidden");
    doneEl.classList.add("hidden");
    editorTitle.textContent = `Edit: ${pub.title}`;
    editorEl.classList.remove("hidden");
    updatePreview();
  }

  async function save() {
    errorEl.classList.add("hidden");
    doneEl.classList.add("hidden");
    const payload = {
      title: valueOf("title"),
      authors: authors
        .map((a) => ({ name: a.name.trim(), memberSlug: a.memberSlug || undefined }))
        .filter((a) => a.name),
      venue: valueOf("venue"),
      year: Number(valueOf("year")),
      type: valueOf("type"),
      url: valueOf("url") || undefined,
    };
    try {
      if (editingId) {
        await api(`/content/publications/${editingId}`, { method: "PUT", body: JSON.stringify(payload) });
      } else {
        const data = await api<{ id: string }>("/content/publications", { method: "POST", body: JSON.stringify(payload) });
        editingId = data.id;
        idInput.value = data.id;
      }
      doneEl.textContent = "Draft saved.";
      doneEl.classList.remove("hidden");
      await load();
    } catch (err: any) {
      errorEl.textContent = err.message ?? "Could not save.";
      errorEl.classList.remove("hidden");
    }
  }

  async function publish(id: string) {
    errorEl.classList.add("hidden");
    doneEl.classList.add("hidden");
    try {
      const data = await api<{ url: string }>(`/content/publications/${id}/publish`, { method: "POST" });
      doneEl.textContent = `Published — ${data.url ?? ""}`.replace(/\s+$/, "");
      doneEl.classList.remove("hidden");
      await load();
    } catch (err: any) {
      errorEl.textContent = err.message ?? "Publish failed.";
      errorEl.classList.remove("hidden");
    }
  }

  async function removePub(pub: any) {
    if (!confirm(`Delete "${pub.title}"?`)) return;
    errorEl.classList.add("hidden");
    doneEl.classList.add("hidden");
    try {
      await api(`/content/publications/${pub.id}`, { method: "DELETE" });
      if (editingId === pub.id) {
        editorEl.classList.add("hidden");
      }
      doneEl.textContent = "Deleted.";
      doneEl.classList.remove("hidden");
      await load();
    } catch (err: any) {
      errorEl.textContent = err.message ?? "Could not delete.";
      errorEl.classList.remove("hidden");
    }
  }

  authorsAdd.addEventListener("click", () => {
    authors.push({ id: authorId++, name: "" });
    renderAuthors();
  });
  form.addEventListener("submit", (e) => {
    e.preventDefault();
    save();
  });
  document.getElementById("publish-btn")!.addEventListener("click", async () => {
    if (!editingId) {
      await save();
    }
    if (editingId) await publish(editingId);
  });
  document.getElementById("cancel-btn")!.addEventListener("click", () => {
    editorEl.classList.add("hidden");
  });
  document.getElementById("new-pub")!.addEventListener("click", openNew);
  ["title", "venue", "year", "type"].forEach((name) => {
    (form.elements.namedItem(name) as HTMLElement).addEventListener("input", updatePreview);
  });

  load();
  loadTeam();
</script>
