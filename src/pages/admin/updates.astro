---
import BaseLayout from "../../layouts/BaseLayout.astro";

export const prerender = false;
---

<BaseLayout title="Updates editor" description="Manage the latest updates shown on the home page">
  <h1 class="text-3xl font-semibold tracking-tight">Latest Updates</h1>
  <p class="mt-2 text-sm text-neutral-500 dark:text-neutral-400">
    One-line news updates shown on the home page. Each needs a date and a short update; publishing syncs it into the site.
  </p>

  <form id="update-form" class="mt-6 max-w-2xl space-y-4" novalidate>
    <div class="grid gap-4 sm:grid-cols-3">
      <div>
        <label for="date" class="block text-sm font-medium text-neutral-700 dark:text-neutral-300">Date</label>
        <input id="date" type="date" required
          class="mt-1 w-full rounded border border-neutral-300 dark:border-neutral-600 bg-white dark:bg-neutral-800 px-3 py-2 text-sm text-neutral-900 dark:text-neutral-100 focus:border-blue-500 focus:outline-none" />
      </div>
      <div class="sm:col-span-2">
        <label for="text" class="block text-sm font-medium text-neutral-700 dark:text-neutral-300">Update</label>
        <input id="text" type="text" required maxlength={500} placeholder="e.g. QRNLab members presented at ICP-2026"
          class="mt-1 w-full rounded border border-neutral-300 dark:border-neutral-600 bg-white dark:bg-neutral-800 px-3 py-2 text-sm text-neutral-900 dark:text-neutral-100 focus:border-blue-500 focus:outline-none" />
      </div>
    </div>

    <p id="error" class="hidden text-sm text-red-600 dark:text-red-400"></p>
    <p id="done" class="hidden text-sm text-green-700 dark:text-green-400"></p>

    <button type="submit"
      class="rounded bg-[#0b0d39] dark:bg-[#f4f2c7] px-5 py-2 text-sm font-medium text-white dark:text-[#0b0d39] hover:opacity-90 transition-opacity">
      Add update
    </button>
  </form>

  <section class="mt-10">
    <h2 class="text-2xl font-medium tracking-tight border-b border-neutral-200 dark:border-neutral-700 pb-2">All updates</h2>
    <div id="list" class="mt-4 space-y-3 max-w-2xl"></div>
  </section>
</BaseLayout>

<script>
  import { api } from "../../lib/client/api";

  const form = document.getElementById("update-form") as HTMLFormElement;
  const dateInput = document.getElementById("date") as HTMLInputElement;
  const textInput = document.getElementById("text") as HTMLInputElement;
  const errorEl = document.getElementById("error")!;
  const doneEl = document.getElementById("done")!;
  const listEl = document.getElementById("list")!;

  function formatDate(value: string): string {
    const d = new Date(value + "T00:00:00");
    return isNaN(d.getTime())
      ? value
      : d.toLocaleDateString("en-US", { year: "numeric", month: "short", day: "numeric" });
  }

  async function load() {
    const data = await api<{ updates: any[] }>("/content/updates");
    const updates = data.updates ?? [];
    listEl.innerHTML = "";
    if (updates.length === 0) {
      listEl.innerHTML = '<p class="text-sm text-neutral-500 dark:text-neutral-400 italic">No updates yet.</p>';
      return;
    }
    for (const update of updates) {
      const row = document.createElement("div");
      row.className = "flex items-center justify-between gap-4 rounded-lg border border-neutral-200 dark:border-neutral-700 p-4";
      const info = document.createElement("p");
      info.className = "text-sm text-neutral-700 dark:text-neutral-300";
      info.innerHTML = "";
      const date = document.createElement("span");
      date.className = "font-medium text-neutral-900 dark:text-neutral-100";
      date.textContent = formatDate(update.date);
      info.append(date, document.createTextNode("  " + update.text));
      const actions = document.createElement("div");
      actions.className = "flex gap-2";
      const delBtn = document.createElement("button");
      delBtn.className = "shrink-0 rounded border border-neutral-300 dark:border-neutral-600 px-3 py-1 text-xs text-neutral-700 dark:text-neutral-300 hover:bg-neutral-100 dark:hover:bg-neutral-800 hover:border-red-400 hover:text-red-600 transition-colors";
      delBtn.textContent = "Delete";
      delBtn.addEventListener("click", async () => {
        if (!confirm(`Delete update "${update.text}"?`)) return;
        try {
          await api(`/content/updates/${update.id}`, { method: "DELETE" });
          await load();
        } catch (err: any) {
          errorEl.textContent = err.message ?? "Could not delete update.";
          errorEl.classList.remove("hidden");
        }
      });
      actions.appendChild(delBtn);
      row.appendChild(info);
      row.appendChild(actions);
      listEl.appendChild(row);
    }
  }

  form.addEventListener("submit", async (e) => {
    e.preventDefault();
    errorEl.classList.add("hidden");
    doneEl.classList.add("hidden");
    const payload = {
      date: dateInput.value,
      text: textInput.value.trim(),
    };
    try {
      const data = await api<{ url?: string }>("/content/updates", {
        method: "POST",
        body: JSON.stringify(payload),
      });
      doneEl.textContent = `Added — ${data.url ?? "published"}`;
      doneEl.classList.remove("hidden");
      form.reset();
      await load();
    } catch (err: any) {
      errorEl.textContent = err.message ?? "Could not add update.";
      errorEl.classList.remove("hidden");
    }
  });

  load();
</script>
