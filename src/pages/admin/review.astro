---
import BaseLayout from "../../layouts/BaseLayout.astro";
import { desc, eq } from "drizzle-orm";
import { getDb } from "../../lib/server/db";
import { profileSubmissions, users } from "../../lib/server/schema";

export const prerender = false;

const FIELD_LABELS: Record<string, string> = {
  category: "Category",
  name: "Name",
  role: "Role",
  focus: "Research focus",
  email: "Email",
  bio: "Biography",
  website: "Website",
  scholar: "Google Scholar",
  linkedin: "LinkedIn",
  github: "GitHub",
  currentPosition: "Current position",
  currentInstitution: "Current institution",
  yearGraduated: "Graduation year",
  links: "Links",
  publications: "Publications",
};

function displayValue(v: unknown): string {
  if (v === null || v === undefined || v === "") return "—";
  if (Array.isArray(v)) {
    if (v.length === 0) return "—";
    return v
      .map((item) =>
        typeof item === "object" && item !== null
          ? `${(item as any).label ?? ""} (${(item as any).url ?? ""})`
          : String(item),
      )
      .join(", ");
  }
  if (typeof v === "object") return JSON.stringify(v);
  return String(v);
}

interface Change {
  label: string;
  before: string;
  after: string;
}

function diffPayloads(
  before: Record<string, unknown>,
  after: Record<string, unknown>,
): Change[] {
  const changes: Change[] = [];
  for (const key of Object.keys(FIELD_LABELS)) {
    const b = displayValue(before[key]);
    const a = displayValue(after[key]);
    if (b !== a) changes.push({ label: FIELD_LABELS[key], before: b, after: a });
  }
  return changes;
}

const db = await getDb();
const subs = await db
  .select({
    id: profileSubmissions.id,
    userId: profileSubmissions.userId,
    payload: profileSubmissions.payload,
    status: profileSubmissions.status,
    submittedAt: profileSubmissions.submittedAt,
    reviewedAt: profileSubmissions.reviewedAt,
    userName: users.name,
    userEmail: users.email,
  })
  .from(profileSubmissions)
  .leftJoin(users, eq(users.id, profileSubmissions.userId))
  .orderBy(desc(profileSubmissions.submittedAt));

const lastApproved = new Map<string, Record<string, unknown>>();
for (const s of subs) {
  if (s.status === "approved" && !lastApproved.has(s.userId)) {
    lastApproved.set(s.userId, s.payload);
  }
}

const statusStyles: Record<string, string> = {
  pending: "bg-amber-100 dark:bg-amber-950/40 text-amber-800 dark:text-amber-300",
  approved: "bg-green-100 dark:bg-green-950/40 text-green-800 dark:text-green-300",
  rejected: "bg-red-100 dark:bg-red-950/40 text-red-800 dark:text-red-300",
};
---

<BaseLayout title="Profile review" description="Review all profile submissions">
  <h1 class="text-3xl font-semibold tracking-tight">Profile review</h1>
  <p class="mt-2 text-sm text-neutral-500 dark:text-neutral-400">
    Full history of member profile submissions, newest first. Pending entries show what changed since the last approved version.
  </p>

  <div class="mt-4 flex flex-wrap gap-3 text-sm">
    <a href="/admin" class="rounded border border-neutral-300 dark:border-neutral-600 px-4 py-2 text-neutral-700 dark:text-neutral-300 hover:bg-neutral-100 dark:hover:bg-neutral-800 transition-colors">&larr; Admin</a>
  </div>

  {subs.length === 0 ? (
    <p class="mt-8 text-sm text-neutral-500 dark:text-neutral-400 italic">No submissions yet.</p>
  ) : (
    <ul class="mt-6 space-y-5">
      {subs.map((s) => {
        const pending = s.status === "pending";
        const baseline = lastApproved.get(s.userId);
        const changes = pending && baseline ? diffPayloads(baseline, s.payload) : [];
        return (
          <li class="rounded-lg border border-neutral-200 dark:border-neutral-700 p-5" data-submission={s.userId}>
            <div class="flex flex-wrap items-center gap-x-3 gap-y-1">
              <h2 class="font-medium text-neutral-900 dark:text-neutral-100">{s.userName}</h2>
              <span class="text-sm text-neutral-500 dark:text-neutral-400">&lt;{s.userEmail}&gt;</span>
              <span class={`rounded px-2 py-0.5 text-xs font-medium ${statusStyles[s.status]}`}>{s.status}</span>
              <span class="text-xs text-neutral-400 dark:text-neutral-500">
                {s.submittedAt.toLocaleString()}
              </span>
            </div>

            {pending && (
              <div class="mt-4">
                {baseline ? (
                  changes.length > 0 ? (
                    <div class="overflow-x-auto rounded border border-neutral-200 dark:border-neutral-700">
                      <table class="w-full text-left text-sm">
                        <thead class="bg-neutral-50 dark:bg-neutral-800/50">
                          <tr class="text-neutral-500 dark:text-neutral-400">
                            <th class="px-4 py-2 font-medium">Field</th>
                            <th class="px-4 py-2 font-medium">Before</th>
                            <th class="px-4 py-2 font-medium">After</th>
                          </tr>
                        </thead>
                        <tbody>
                          {changes.map((ch) => (
                            <tr class="border-t border-neutral-200 dark:border-neutral-700">
                              <td class="px-4 py-2 font-medium text-neutral-900 dark:text-neutral-100">{ch.label}</td>
                              <td class="px-4 py-2 text-neutral-500 dark:text-neutral-400 whitespace-pre-line line-through decoration-neutral-400/60">{ch.before}</td>
                              <td class="px-4 py-2 text-neutral-900 dark:text-neutral-100 whitespace-pre-line">{ch.after}</td>
                            </tr>
                          ))}
                        </tbody>
                      </table>
                    </div>
                  ) : (
                    <p class="text-sm text-neutral-500 dark:text-neutral-400 italic">No field changes since the last approved version.</p>
                  )
                ) : (
                  <div>
                    <p class="text-sm font-medium text-neutral-900 dark:text-neutral-100">New profile submission</p>
                    <dl class="mt-2 grid gap-x-6 gap-y-1 text-sm sm:grid-cols-2">
                      {Object.keys(FIELD_LABELS).map((key) => {
                        const v = displayValue(s.payload[key]);
                        if (v === "—") return null;
                        return (
                          <div class="flex gap-2">
                            <dt class="shrink-0 font-medium text-neutral-500 dark:text-neutral-400">{FIELD_LABELS[key]}:</dt>
                            <dd class="text-neutral-900 dark:text-neutral-100 whitespace-pre-line">{v}</dd>
                          </div>
                        );
                      })}
                    </dl>
                  </div>
                )}

                <div class="mt-4 flex gap-2">
                  <button data-action="approve" class="rounded bg-green-700 dark:bg-green-600 px-4 py-1.5 text-sm text-white hover:opacity-90 transition-opacity">Approve</button>
                  <button data-action="reject" class="rounded border border-neutral-300 dark:border-neutral-600 px-4 py-1.5 text-sm text-neutral-700 dark:text-neutral-300 hover:bg-neutral-100 dark:hover:bg-neutral-800 transition-colors">Reject</button>
                </div>
                <p class="mt-2 hidden text-sm text-green-700 dark:text-green-400" data-result></p>
              </div>
            )}

            {!pending && (
              <details class="mt-3">
                <summary class="cursor-pointer text-sm text-neutral-500 dark:text-neutral-400 hover:text-neutral-700 dark:hover:text-neutral-200">View submitted data</summary>
                <dl class="mt-2 grid gap-x-6 gap-y-1 text-sm sm:grid-cols-2">
                  {Object.keys(FIELD_LABELS).map((key) => {
                    const v = displayValue(s.payload[key]);
                    if (v === "—") return null;
                    return (
                      <div class="flex gap-2">
                        <dt class="shrink-0 font-medium text-neutral-500 dark:text-neutral-400">{FIELD_LABELS[key]}:</dt>
                        <dd class="text-neutral-900 dark:text-neutral-100 whitespace-pre-line">{v}</dd>
                      </div>
                    );
                  })}
                </dl>
              </details>
            )}
          </li>
        );
      })}
    </ul>
  )}
</BaseLayout>

<script>
  document.querySelectorAll<HTMLElement>("[data-submission]").forEach((card) => {
    const userId = card.dataset.submission!;
    const resultEl = card.querySelector<HTMLElement>("[data-result]")!;
    card.querySelectorAll<HTMLButtonElement>("[data-action]").forEach((btn) => {
      btn.addEventListener("click", async () => {
        const action = btn.dataset.action!;
        btn.disabled = true;
        const res = await fetch(`/api/admin/members/${userId}/${action}`, {
          method: "POST",
          headers: { "Content-Type": "application/json" },
          body: "{}",
        });
        const data = await res.json().catch(() => null);
        if (res.ok) {
          resultEl.textContent = action === "approve"
            ? `Approved.${data?.url ? ` Pull request: ${data.url}` : ""}`
            : "Rejected.";
          resultEl.classList.remove("hidden");
          setTimeout(() => location.reload(), 1500);
        } else {
          resultEl.textContent = data?.error ?? "Failed.";
          resultEl.classList.add("text-red-600", "dark:text-red-400");
          resultEl.classList.remove("hidden");
          btn.disabled = false;
        }
      });
    });
  });
</script>
