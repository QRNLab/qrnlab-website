---
import BaseLayout from "../layouts/BaseLayout.astro";
---

<BaseLayout title="Blog" description="QRNLab blog — videos, posts, and articles">
  <h1 class="text-3xl font-semibold tracking-tight">Blog</h1>

  <section class="mt-8">
    <h2 class="text-2xl font-medium tracking-tight border-b border-neutral-200 dark:border-neutral-700 pb-2">YouTube Videos</h2>
    <p class="mt-4 text-sm text-neutral-500 dark:text-neutral-400 italic">No videos listed yet.</p>
  </section>

  <section class="mt-12">
    <h2 class="text-2xl font-medium tracking-tight border-b border-neutral-200 dark:border-neutral-700 pb-2">LinkedIn Posts</h2>
    <p class="mt-4 text-sm text-neutral-500 dark:text-neutral-400 italic">No posts listed yet.</p>
  </section>

  <section class="mt-12">
    <h2 class="text-2xl font-medium tracking-tight border-b border-neutral-200 dark:border-neutral-700 pb-2">Articles</h2>
    <p class="mt-4 text-sm text-neutral-500 dark:text-neutral-400 italic">No articles published yet.</p>
  </section>
</BaseLayout>
