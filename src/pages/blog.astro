---
import BaseLayout from "../layouts/BaseLayout.astro";
import { getCollection } from "astro:content";

const posts = (await getCollection("blog"))
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());
---

<BaseLayout title="Blog" description="QRNLab blog — lab news and articles">
  <h1 class="text-3xl font-semibold tracking-tight">Blog</h1>
  <p class="mt-3 text-neutral-600 dark:text-neutral-400 max-w-3xl">
    Lab news, notes, and updates on our research.
  </p>

  {posts.length === 0 ? (
    <p class="mt-8 text-sm text-neutral-500 dark:text-neutral-400 italic">No posts yet.</p>
  ) : (
    <ul class="mt-8 space-y-5">
      {posts.map((post) => (
        <li>
          <a href={`/blog/${post.id}`} class="block rounded-lg border border-neutral-200 dark:border-neutral-700 p-5 hover:border-blue-300 dark:hover:border-blue-600 hover:bg-blue-50/30 dark:hover:bg-blue-950/30 transition-colors">
            <div class="flex items-center gap-3 text-xs text-neutral-500 dark:text-neutral-400">
              <span>{post.data.date.toLocaleDateString("en-US", { year: "numeric", month: "short", day: "numeric" })}</span>
              {post.data.author && <span>· {post.data.author}</span>}
            </div>
            <h2 class="mt-1.5 text-lg font-medium text-neutral-900 dark:text-neutral-100">{post.data.title}</h2>
            {post.data.excerpt && (
              <p class="mt-1 text-sm text-neutral-600 dark:text-neutral-400 leading-relaxed">{post.data.excerpt}</p>
            )}
            {post.data.tags && post.data.tags.length > 0 && (
              <div class="mt-3 flex flex-wrap gap-2">
                {post.data.tags.map((tag) => (
                  <span class="rounded bg-neutral-100 dark:bg-neutral-800 px-2 py-0.5 text-xs text-neutral-600 dark:text-neutral-400">{tag}</span>
                ))}
              </div>
            )}
          </a>
        </li>
      ))}
    </ul>
  )}
</BaseLayout>
