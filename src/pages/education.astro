---
import BaseLayout from "../layouts/BaseLayout.astro";
---

<BaseLayout title="Education" description="QRNLab education and outreach resources">
  <h1 class="text-3xl font-semibold tracking-tight">Education &amp; Outreach</h1>

  <section class="mt-8">
    <h2 class="text-2xl font-medium tracking-tight border-b border-neutral-200 dark:border-neutral-700 pb-2">Lecture Notes</h2>
    <p class="mt-4 text-sm text-neutral-500 dark:text-neutral-400 italic">No lecture notes uploaded yet.</p>
  </section>

  <section class="mt-12">
    <h2 class="text-2xl font-medium tracking-tight border-b border-neutral-200 dark:border-neutral-700 pb-2">Presentation Slides</h2>
    <p class="mt-4 text-sm text-neutral-500 dark:text-neutral-400 italic">No presentation slides uploaded yet.</p>
  </section>

  <section class="mt-12">
    <h2 class="text-2xl font-medium tracking-tight border-b border-neutral-200 dark:border-neutral-700 pb-2">Workshops</h2>
    <p class="mt-4 text-sm text-neutral-500 dark:text-neutral-400 italic">No workshops listed yet.</p>
  </section>
</BaseLayout>
