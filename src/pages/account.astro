---
import BaseLayout from "../layouts/BaseLayout.astro";
import Avatar from "../components/Avatar.astro";
import { getEntry } from "astro:content";
import { eq } from "drizzle-orm";
import { getDb } from "../lib/server/db";
import { memberProfiles } from "../lib/server/schema";

export const prerender = false;

const session = Astro.locals.session;
const db = await getDb();
const [profile] = session
  ? await db.select().from(memberProfiles).where(eq(memberProfiles.userId, session.user.id))
  : [];
const p = profile ?? null;

const entry = p?.slug ? await getEntry("team", p.slug) : null;
const data = entry?.data ?? null;
const body = entry?.body ?? null;

const statusStyles: Record<string, string> = {
  approved: "bg-green-100 dark:bg-green-950/40 text-green-800 dark:text-green-300",
  pending: "bg-amber-100 dark:bg-amber-950/40 text-amber-800 dark:text-amber-300",
  rejected: "bg-red-100 dark:bg-red-950/40 text-red-800 dark:text-red-300",
};
---

<BaseLayout title="Account" description="Your QRNLab profile">
  <div class="flex flex-wrap items-center justify-between gap-4">
    <div>
      <h1 class="text-3xl font-semibold tracking-tight">Account</h1>
      <p class="mt-2 text-sm text-neutral-500 dark:text-neutral-400">
        Signed in as <span class="font-medium text-neutral-700 dark:text-neutral-300">{session?.user.email}</span>
      </p>
    </div>
    <div class="flex flex-wrap items-center gap-3">
      <a
        href="/account/posts"
        class="rounded border border-neutral-300 dark:border-neutral-600 px-5 py-2 text-sm text-neutral-700 dark:text-neutral-300 hover:bg-neutral-100 dark:hover:bg-neutral-800 transition-colors"
      >
        My posts
      </a>
      <a
        href="/account/edit"
        class="rounded bg-[#0b0d39] dark:bg-[#f4f2c7] px-5 py-2 text-sm font-medium text-white dark:text-[#0b0d39] hover:opacity-90 transition-opacity"
      >
        Edit profile
      </a>
    </div>
  </div>

  {!p && (
    <p class="mt-6 max-w-3xl rounded-lg border border-neutral-200 dark:border-neutral-700 bg-neutral-50 dark:bg-neutral-800/40 p-4 text-sm text-neutral-600 dark:text-neutral-300">
      You haven't published a profile yet. Use <a href="/account/edit" class="text-blue-700 dark:text-blue-400 hover:underline">Edit profile</a> to submit your information; an admin reviews it before it appears on the site.
    </p>
  )}

  {p && p.status === "pending" && (
    <p class="mt-6 max-w-3xl rounded-lg border border-amber-200 dark:border-amber-800 bg-amber-50 dark:bg-amber-950/30 p-4 text-sm text-amber-800 dark:text-amber-300">
      Your latest changes are awaiting admin review. Below is the currently published version.
    </p>
  )}
  {p && p.status === "rejected" && (
    <p class="mt-6 max-w-3xl rounded-lg border border-red-200 dark:border-red-900 bg-red-50 dark:bg-red-950/30 p-4 text-sm text-red-800 dark:text-red-300">
      Your last submission was rejected. <a href="/account/edit" class="underline">Edit and resubmit</a>.
    </p>
  )}
  {p && p.status === "approved" && (
    <p class="mt-6 max-w-3xl rounded-lg border border-green-200 dark:border-green-900 bg-green-50 dark:bg-green-950/30 p-4 text-sm text-green-800 dark:text-green-300">
      Your profile is live on the site.
      {entry && <> <a href={`/team/${entry.data.category}/${entry.id}`} class="underline">View your public profile</a>.</>}
    </p>
  )}

  {!data ? (
    <p class="mt-8 text-sm text-neutral-500 dark:text-neutral-400 italic">No published profile yet.</p>
  ) : (
    <section class="mt-8 max-w-3xl">
      <div class="flex items-start gap-6">
        <Avatar name={data.name} image={data.image} size={96} />
        <div>
          <h2 class="text-2xl font-semibold tracking-tight">{data.name}</h2>
          <p class={`mt-1 inline-block rounded px-2 py-0.5 text-xs font-medium ${statusStyles[p?.status ?? "pending"]}`}>
            {data.category}
          </p>
          {data.role && <p class="mt-1 text-neutral-600 dark:text-neutral-400">{data.role}</p>}
          {data.focus && <p class="text-sm text-neutral-500 dark:text-neutral-400">{data.focus}</p>}
          {data.email && (
            <p class="mt-1 text-sm">
              <a href={`mailto:${data.email}`} class="text-neutral-500 dark:text-neutral-400 hover:text-blue-700 dark:hover:text-blue-400 underline transition-colors">{data.email}</a>
            </p>
          )}
        </div>
      </div>

      {(data.website || data.scholar || data.linkedin || data.github || (data.links ?? []).length > 0) && (
        <ul class="mt-4 flex flex-wrap gap-x-5 gap-y-1">
          {[
            { label: "Website", url: data.website },
            { label: "Google Scholar", url: data.scholar },
            { label: "LinkedIn", url: data.linkedin },
            { label: "GitHub", url: data.github },
          ]
            .concat(data.links ?? [])
            .filter((l) => l.url)
            .map((l) => (
              <li>
                <a href={l.url} target="_blank" rel="noopener noreferrer" class="text-sm text-neutral-500 dark:text-neutral-400 hover:text-blue-700 dark:hover:text-blue-400 transition-colors">
                  {l.label}
                </a>
              </li>
            ))}
        </ul>
      )}

      {body && (
        <div class="mt-6 text-neutral-700 dark:text-neutral-300 leading-relaxed space-y-4">
          {body.split("\n\n").filter(Boolean).map((para) => (
            <p class="whitespace-pre-line">{para.trim()}</p>
          ))}
        </div>
      )}

      {(data.publications ?? []).length > 0 && (
        <div class="mt-8">
          <h3 class="text-lg font-medium text-neutral-900 dark:text-neutral-100">Publications</h3>
          <ul class="mt-2 space-y-2">
            {(data.publications ?? []).map((pub) => (
              <li class="text-sm text-neutral-700 dark:text-neutral-300 leading-relaxed">{pub}</li>
            ))}
          </ul>
        </div>
      )}
    </section>
  )}
</BaseLayout>
