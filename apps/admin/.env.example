# Production secrets for the qrnlab-app worker. Set with:
#   wrangler secret put <NAME> --name qrnlab-app
# (or in the Cloudflare dashboard → Workers → qrnlab-app → Settings → Variables)

# --- Auth ---
# Generate with: openssl rand -base64 32
BETTER_AUTH_SECRET=""
BETTER_AUTH_URL="https://app.qrnlab.org"

# Email verification (Resend) — MAIL_FROM must be a verified domain address
RESEND_API_KEY=""
MAIL_FROM="QRNLab <onboarding@qrnlab.dev>"

# Comma-separated emails auto-promoted to admin on sign-up (first admin bootstrap)
ADMIN_EMAILS=""

# --- Build-time content endpoint (the static site's loader calls /api/__build) ---
# Must match BUILD_TOKEN configured in the qrnlab-site build.
BUILD_TOKEN=""

# --- Queued rebuild: POSTed when an admin clicks "Rebuild" ---
# The qrnlab-site project's Cloudflare Workers Builds Deploy Hook URL.
DEPLOY_HOOK_URL=""
