---
import { extractYoutubeId, youtubeEmbedUrl } from "@qrnlab/shared";

interface Props {
  entry: {
    data: {
      heading: string;
      description?: string;
      links?: { label: string; url: string }[];
      youtubeLinks?: string[];
      images?: string[];
    };
  };
}

const { entry } = Astro.props;
const { data } = entry;
const embeds = (data.youtubeLinks ?? [])
  .map((url) => extractYoutubeId(url))
  .filter((id): id is string => id !== null)
  .map((id) => youtubeEmbedUrl(id));
const images = data.images ?? [];
---

<li class="rounded-lg border border-neutral-200 dark:border-neutral-700 p-5">
  <h3 class="font-medium text-neutral-900 dark:text-neutral-100">{data.heading}</h3>

  {data.description && (
    <p class="mt-1.5 text-sm text-neutral-600 dark:text-neutral-400 whitespace-pre-line leading-relaxed">{data.description}</p>
  )}

  {images.length > 0 && (
    <div class="mt-4 grid grid-cols-1 gap-4 sm:grid-cols-2">
      {images.map((key) => (
        <div class="overflow-hidden rounded-lg border border-neutral-200 dark:border-neutral-700 bg-neutral-100 dark:bg-neutral-800">
          <img
            src={`/media/${key}`}
            alt={data.heading}
            loading="lazy"
            class="h-full w-full object-contain"
          />
        </div>
      ))}
    </div>
  )}

  {(data.links ?? []).length > 0 && (
    <ul class="mt-3 flex flex-wrap gap-x-5 gap-y-1">
      {(data.links ?? []).map((link) => (
        <li>
          <a
            href={link.url}
            target="_blank"
            rel="noopener noreferrer"
            class="text-sm text-blue-700 dark:text-blue-400 hover:underline"
          >
            {link.label}
          </a>
        </li>
      ))}
    </ul>
  )}

  {embeds.length > 0 && (
    <div class="mt-4 space-y-4">
      {embeds.map((src) => (
        <div class="aspect-video w-full max-w-2xl overflow-hidden rounded-lg border border-neutral-200 dark:border-neutral-700">
          <iframe
            src={src}
            title="YouTube video player"
            loading="lazy"
            allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share"
            allowfullscreen
            class="h-full w-full"
          />
        </div>
      ))}
    </div>
  )}
</li>
