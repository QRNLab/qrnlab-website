---
import BaseLayout from "../layouts/BaseLayout.astro";
import { getCollection } from "astro:content";

const pubs = (await getCollection("publications")).sort((a, b) => b.data.year - a.data.year);
const team = await getCollection("team");
const teamById = new Map(team.map((e) => [e.id, e]));
const groups = [
  { type: "journal", label: "Journal Papers" },
  { type: "conference", label: "Conference Attendings" },
  { type: "preprint", label: "Preprints" },
] as const;
---

<BaseLayout title="Publications" description="QRNLab publications and conference attendings">
  <h1 class="text-3xl font-semibold tracking-tight">Publications</h1>

  {groups.map((group) => {
    const items = pubs.filter((p) => p.data.type === group.type);
    return (
      <section class="mt-8">
        <h2 class="text-2xl font-medium tracking-tight border-b border-neutral-200 dark:border-neutral-700 pb-2">{group.label}</h2>
        {items.length === 0 ? (
          <p class="mt-4 text-sm text-neutral-500 dark:text-neutral-400 italic">No {group.label.toLowerCase()} listed yet.</p>
        ) : (
          <ul class="mt-4 space-y-4 max-w-3xl">
            {items.map((entry) => (
              <li class="pl-4 border-l-2 border-blue-500/40">
                <p class="font-medium text-neutral-900 dark:text-neutral-100 leading-snug">{entry.data.title}</p>
                <p class="mt-0.5 text-sm text-neutral-600 dark:text-neutral-400">
                  {entry.data.authors.map((a, i) => {
                    const member = a.memberSlug ? teamById.get(a.memberSlug) : undefined;
                    return (
                      <Fragment>
                        {i > 0 && <span>, </span>}
                        {member ? (
                          <a href={`/team/${member.data.category}/${member.id}`} class="text-blue-700 dark:text-blue-400 hover:underline">{a.name}</a>
                        ) : (
                          <span>{a.name}</span>
                        )}
                      </Fragment>
                    );
                  })}
                </p>
                <p class="mt-0.5 text-xs text-neutral-500 dark:text-neutral-400">
                  {entry.data.venue}, {entry.data.year}
                  {entry.data.url && (
                    <> · <a href={entry.data.url} target="_blank" rel="noopener noreferrer" class="text-blue-700 dark:text-blue-400 hover:underline">Link</a></>
                  )}
                </p>
              </li>
            ))}
          </ul>
        )}
      </section>
    );
  })}
</BaseLayout>
