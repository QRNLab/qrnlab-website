---
import "../styles/global.css";

export interface Props {
  title: string;
  description?: string;
}

const { title, description } = Astro.props;
const currentPath = Astro.url.pathname;

function normalizePath(path: string): string {
  if (path.length > 1 && path.endsWith("/")) return path.slice(0, -1);
  return path;
}

function isActive(href: string): boolean {
  const path = normalizePath(currentPath);
  if (href === "/") return path === "/";
  if (href === "/team") return path === href || path.startsWith("/team/");
  if (href === "/blog") return path === href || path.startsWith("/blog/");
  return path === href;
}

const navItems = [
  { href: "/", label: "Home" },
  { href: "/about", label: "About" },
  { href: "/research", label: "Research" },
  { href: "/team", label: "Team" },
  { href: "/publications", label: "Publications" },
  { href: "/affiliates", label: "Affiliates" },
  { href: "/education", label: "Education" },
  { href: "/blog", label: "Blog" },
];
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <link rel="icon" type="image/png" href="/favicon.png" />
    <link rel="icon" href="/favicon.ico" sizes="any" />
    <meta name="viewport" content="width=device-width" />
    <meta name="generator" content={Astro.generator} />
    <meta name="description" content={description ?? "QRNLab — research laboratory"} />
    <title>{title} | QRNLab</title>
    <script is:inline>
      (function () {
        const stored = localStorage.getItem("theme");
        const prefersDark = window.matchMedia("(prefers-color-scheme: dark)").matches;
        if (stored === "dark" || (!stored && prefersDark)) {
          document.documentElement.classList.add("dark");
        }
      })();
    </script>
  </head>
  <body class="bg-white dark:bg-neutral-900 text-neutral-900 dark:text-neutral-100 font-sans antialiased transition-colors duration-200">
    <header class="border-b border-neutral-200 bg-white dark:border-neutral-800 dark:bg-neutral-900">
      <nav class="relative mx-auto flex max-w-5xl items-center justify-between px-4 py-4">
        <a href="/" class="flex items-center gap-2 text-lg font-semibold tracking-tight text-neutral-900 dark:text-neutral-100">
          <img src="/logo/qrnlab-mark.png" alt="" width="128" height="121" class="h-7 w-auto" />
          <span>QRNLab</span>
        </a>

        <ul id="nav-links" class="hidden absolute left-0 right-0 top-full z-50 flex-col bg-white shadow-lg dark:bg-neutral-900 md:static md:z-auto md:flex md:flex-row md:items-center md:gap-6 md:bg-transparent md:dark:bg-transparent md:ml-auto md:p-0 md:text-sm md:shadow-none">
          {navItems.map((item) => (
            <li>
              <a
                href={item.href}
                class={`nav-link block px-4 py-3 md:px-0 md:py-0 ${isActive(item.href)
                  ? "active font-medium text-amber-600 dark:text-amber-400"
                  : "text-neutral-600 hover:text-neutral-900 dark:text-neutral-400 dark:hover:text-neutral-100"
                }`}
              >
                {item.label}
              </a>
            </li>
          ))}
        </ul>

        <div class="flex items-center gap-2 md:ml-4 md:gap-1">
          <button
            type="button"
            aria-label="Toggle dark mode"
            onclick="toggleDarkMode()"
            class="p-2 text-neutral-500 hover:text-neutral-900 dark:text-neutral-400 dark:hover:text-neutral-100 transition-colors"
          >
            <span class="dark:hidden" aria-hidden="true">
              <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z"/></svg>
            </span>
            <span class="hidden dark:inline" aria-hidden="true">
              <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="5"/><line x1="12" y1="1" x2="12" y2="3"/><line x1="12" y1="21" x2="12" y2="23"/><line x1="4.22" y1="4.22" x2="5.64" y2="5.64"/><line x1="18.36" y1="18.36" x2="19.78" y2="19.78"/><line x1="1" y1="12" x2="3" y2="12"/><line x1="21" y1="12" x2="23" y2="12"/><line x1="4.22" y1="19.78" x2="5.64" y2="18.36"/><line x1="18.36" y1="5.64" x2="19.78" y2="4.22"/></svg>
            </span>
          </button>
          <button
            type="button"
            aria-label="Menu"
            onclick="toggleMobileNav()"
            class="p-2 text-neutral-500 hover:text-neutral-900 dark:text-neutral-400 dark:hover:text-neutral-100 md:hidden transition-colors"
          >
            <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><line x1="3" y1="6" x2="21" y2="6"/><line x1="3" y1="12" x2="21" y2="12"/><line x1="3" y1="18" x2="21" y2="18"/></svg>
          </button>
        </div>
      </nav>
    </header>
    <main class="mx-auto max-w-5xl px-4 py-8 sm:py-12">
      <slot />
    </main>
    <footer class="border-t border-neutral-200 dark:border-neutral-700">
      <div class="mx-auto max-w-5xl px-4 py-6">
        <div class="flex flex-col items-center gap-3 text-sm text-neutral-500 dark:text-neutral-400">
          <img src="/logo/qrnlab-mark.png" alt="" width="128" height="121" class="h-9 w-auto" />
          <div class="flex flex-wrap items-center justify-center gap-x-6 gap-y-2">
            <a
              href="mailto:qrnlab.cu@gmail.com"
              class="hover:text-blue-700 dark:hover:text-blue-400 transition-colors"
            >
              Contact Us
            </a>
            <a
              href="https://www.linkedin.com/company/qrnlab"
              target="_blank"
              rel="noopener noreferrer"
              class="hover:text-blue-700 dark:hover:text-blue-400 transition-colors"
            >
              LinkedIn
            </a>
            <a
              href="https://www.facebook.com/share/1Sk2xSLTeE/"
              target="_blank"
              rel="noopener noreferrer"
              class="hover:text-blue-700 dark:hover:text-blue-400 transition-colors"
            >
              Facebook
            </a>
          </div>
          <p>&copy; {new Date().getFullYear()} QRNLab</p>
        </div>
      </div>
    </footer>
    <script is:inline>
      function toggleDarkMode() {
        const html = document.documentElement;
        html.classList.toggle("dark");
        localStorage.setItem("theme", html.classList.contains("dark") ? "dark" : "light");
      }
      let mobileNavAnimation = null;
      function toggleMobileNav() {
        const el = document.getElementById("nav-links");
        if (!el) return;
        if (mobileNavAnimation) {
          mobileNavAnimation.cancel();
          mobileNavAnimation = null;
        }
        const closed = el.classList.contains("hidden");
        const reduced = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
        if (closed) {
          el.classList.remove("hidden");
          if (reduced) return;
          mobileNavAnimation = el.animate(
            [
              { opacity: 0, transform: "translateY(-10px)" },
              { opacity: 1, transform: "translateY(0)" },
            ],
            { duration: 180, easing: "ease-out" }
          );
        } else if (!reduced) {
          mobileNavAnimation = el.animate(
            [
              { opacity: 1, transform: "translateY(0)" },
              { opacity: 0, transform: "translateY(0)" },
            ],
            { duration: 120, easing: "ease-in" }
          );
          mobileNavAnimation.onfinish = () => {
            el.classList.add("hidden");
          };
        } else {
          el.classList.add("hidden");
        }
      }
    </script>
  </body>
</html>
