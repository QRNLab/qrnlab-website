{
  "name": "qrnlab",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.3.0",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "build": "pnpm -r build",
    "dev": "pnpm --filter @qrnlab/site dev",
    "dev:site": "pnpm --filter @qrnlab/site dev",
    "dev:admin": "pnpm --filter @qrnlab/admin dev",
    "check": "pnpm -r check",
    "typecheck": "pnpm -r typecheck",
    "deploy:admin": "pnpm --filter @qrnlab/admin run deploy:admin",
    "deploy:site": "pnpm --filter @qrnlab/site run deploy:site"
  }
}
